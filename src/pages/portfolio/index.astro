---
import FixedWidthLayout from "@/layouts/FixedWidthLayout.astro";
import { Portfolios } from "@/data/portfolios";
import { MdArrowOutward } from "react-icons/md";

const projectYears = Portfolios.flatMap(
    (project) => project.year?.match(/\d{4}/g)?.map(Number) ?? [],
);
const yearRange = projectYears.length
    ? `${Math.min(...projectYears)}–${Math.max(...projectYears)}`
    : undefined;
---

<FixedWidthLayout
    title="Portfolio | Ping Cheng - Software Development Projects"
    description="Explore Ping Cheng's portfolio showcasing modern web applications, full-stack projects, and software solutions using Node.js, TypeScript, React, and cloud technologies."
    keywords="Ping Cheng Portfolio,Software Development Projects,Web Applications,Full Stack Developer,Node.js Projects,TypeScript Applications,React Projects,Cloud Solutions,Enterprise Software,Melbourne Developer"
    ogTitle="Portfolio | Ping Cheng - Software Development Projects"
    ogDescription="Discover innovative software solutions and web applications developed by Ping Cheng. Showcasing expertise in modern technologies and full-stack development."
    ogUrl="https://www.pingchengtech.com/portfolio"
    twitterCard="summary_large_image"
    twitterTitle="Portfolio | Ping Cheng - Software Development Projects"
    twitterDescription="Discover innovative software solutions and web applications developed by Ping Cheng."
>
    <main class="portfolio-page">
        <header class="portfolio-intro animate-fade-in">
            <div class="intro-topline">
                <p class="eyebrow">Selected work</p>
                {yearRange && <p class="year-range">{yearRange}</p>}
            </div>
            <h1>Portfolio</h1>
            <p class="intro-text">
                A selection of things I’ve built, from everyday tools to
                platforms for learning and work.
            </p>
        </header>

        <section aria-label="Projects">
            <div class="collection-heading animate-fade-in animate-delay-100">
                <p>Independent projects &amp; collaborations</p>
                <span>
                    {Portfolios.length.toString().padStart(2, "0")} projects
                </span>
            </div>
            <div class="project-grid">
                {Portfolios.map((project, index) => (
                    <article
                        class:list={[
                            "project",
                            "animate-fade-in",
                            { "project-featured": index === 0 },
                        ]}
                        style={{
                            animationDelay: `${Math.min(120 + index * 50, 350)}ms`,
                        }}
                    >
                        <a
                            class="project-link"
                            href={`/portfolio/${project.slug}`}
                            aria-labelledby={`project-${project.slug}`}
                        >
                            <div class="project-image">
                                <img
                                    src={
                                        project.screenshots[0] ??
                                        project.coverImage
                                    }
                                    alt={`Screenshot of ${project.name}`}
                                    width={800}
                                    height={500}
                                    loading={index === 0 ? "eager" : "lazy"}
                                    decoding="async"
                                />
                            </div>
                            <div class="project-content">
                                {index === 0 && (
                                    <p class="eyebrow featured-label">
                                        Latest project
                                    </p>
                                )}
                                <div class="project-meta">
                                    <span>{project.projectRole}</span>
                                    {project.year && (
                                        <span class="project-year">
                                            {project.year.replace(/-/g, "–")}
                                        </span>
                                    )}
                                </div>
                                <div class="project-title">
                                    <h2 id={`project-${project.slug}`}>
                                        {project.name}
                                    </h2>
                                    <MdArrowOutward
                                        size={22}
                                        aria-hidden="true"
                                    />
                                </div>
                                <p class="project-description">
                                    {project.shortDescription}
                                </p>
                                <span class="view-project" aria-hidden="true">
                                    View project
                                    <MdArrowOutward size={16} />
                                </span>
                            </div>
                        </a>
                    </article>
                ))}
            </div>
        </section>

        <aside
            class="portfolio-outro animate-fade-in animate-delay-300"
            aria-label="About the developer"
        >
            <div>
                <h2>The person behind the projects</h2>
                <p>More about my background and what I’m exploring now.</p>
            </div>
            <a href="/about">
                About me
                <MdArrowOutward size={18} aria-hidden="true" />
            </a>
        </aside>
    </main>
</FixedWidthLayout>

<style>
    .portfolio-page {
        max-width: 920px;
        margin: 0 auto;
        padding: 84px 0 56px;
    }

    .intro-topline,
    .collection-heading,
    .project-meta,
    .project-title,
    .portfolio-outro {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 16px;
    }

    .eyebrow,
    .year-range,
    .collection-heading,
    .project-meta {
        font-size: 12px;
        color: var(--color-text-secondary);
    }

    .eyebrow {
        font-weight: 500;
        letter-spacing: 0.14em;
        text-transform: uppercase;
    }

    .year-range,
    .project-year,
    .collection-heading > span {
        font-variant-numeric: tabular-nums;
        white-space: nowrap;
    }

    h1 {
        margin-top: 35px;
        font-size: clamp(44px, 6.5vw, 76px);
        line-height: 1.1;
        letter-spacing: -0.065em;
        font-weight: 500;
    }

    .intro-text {
        max-width: 620px;
        margin-top: 24px;
        font-size: clamp(19px, 2.4vw, 23px);
        line-height: 1.65;
        letter-spacing: -0.025em;
        text-wrap: pretty;
    }

    .portfolio-intro {
        padding-bottom: 56px;
    }

    .collection-heading {
        padding: 20px 0 28px;
        border-top: 1px solid var(--color-border);
        line-height: 1.6;
    }

    .project-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 40px 32px;
    }

    .project {
        min-width: 0;
    }

    .project-link {
        display: flex;
        flex-direction: column;
        height: 100%;
        border-radius: 3px;
    }

    .project-image {
        flex-shrink: 0;
        overflow: hidden;
        aspect-ratio: 8 / 5;
        padding: 16px 16px 0;
        border: 1px solid var(--color-border);
        background: var(--color-card);
    }

    .project-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: top;
        border: 1px solid var(--color-border);
        border-bottom: 0;
        transition: transform 0.25s ease;
    }

    .project-content {
        display: flex;
        flex: 1;
        flex-direction: column;
        padding-top: 20px;
    }

    .project-meta {
        gap: 8px 16px;
        line-height: 1.6;
    }

    .project-title {
        align-items: center;
        margin-top: 10px;
    }

    .project-title h2 {
        font-size: 22px;
        font-weight: 500;
        line-height: 1.3;
        letter-spacing: -0.035em;
    }

    .project-title :global(svg) {
        flex-shrink: 0;
        color: var(--color-text-secondary);
        transition:
            transform 0.2s ease,
            color 0.2s ease;
    }

    .project-description {
        margin-top: 10px;
        color: var(--color-text-secondary);
        font-size: 15px;
        line-height: 1.8;
        text-wrap: pretty;
    }

    .view-project,
    .portfolio-outro a {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        min-height: 44px;
        font-size: 13px;
    }

    .view-project {
        margin-top: auto;
        padding-top: 12px;
        text-decoration: underline;
        text-decoration-color: var(--color-border);
        text-underline-offset: 5px;
    }

    .view-project :global(svg) {
        display: none;
    }

    .project-featured {
        grid-column: 1 / -1;
        padding-bottom: 40px;
        border-bottom: 1px solid var(--color-border);
    }

    .project-featured .project-link {
        display: grid;
        grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
        align-items: center;
        gap: 40px;
    }

    .project-featured .project-content {
        padding-top: 0;
    }

    .featured-label {
        margin-bottom: 24px;
    }

    .project-featured .project-meta {
        flex-wrap: wrap;
    }

    .project-featured .project-title h2 {
        font-size: clamp(26px, 3vw, 32px);
    }

    .project-featured .project-title :global(svg) {
        display: none;
    }

    .project-featured .view-project :global(svg) {
        display: block;
    }

    .project-link:hover .project-image img {
        transform: translateY(-3px);
    }

    .project-link:hover .project-title :global(svg) {
        color: var(--color-text);
        transform: translate(2px, -2px);
    }

    .project-link:hover .view-project,
    .portfolio-outro a:hover {
        text-decoration-color: currentColor;
    }

    a:focus-visible {
        outline: 2px solid var(--color-accent);
        outline-offset: 7px;
    }

    .portfolio-outro {
        align-items: center;
        margin-top: 48px;
        padding: 32px 0;
        border-top: 1px solid var(--color-border);
    }

    .portfolio-outro h2 {
        font-size: 16px;
        font-weight: 500;
        letter-spacing: -0.025em;
    }

    .portfolio-outro p {
        margin-top: 8px;
        font-size: 14px;
        color: var(--color-text-secondary);
        line-height: 1.7;
    }

    .portfolio-outro a {
        flex-shrink: 0;
        text-decoration: underline;
        text-decoration-color: var(--color-border);
        text-underline-offset: 5px;
    }

    @media (max-width: 700px) {
        .portfolio-page {
            padding-top: 44px;
            padding-bottom: 12px;
        }

        h1 {
            margin-top: 28px;
        }

        .portfolio-intro {
            padding-bottom: 32px;
        }

        .project-grid {
            grid-template-columns: 1fr;
            gap: 32px;
        }

        .project-featured .project-link {
            grid-template-columns: 1fr;
            gap: 20px;
        }

        .project-featured {
            padding-bottom: 24px;
        }

        .featured-label {
            margin-bottom: 12px;
        }

        .project-featured .project-title h2 {
            font-size: 26px;
        }

        .portfolio-outro {
            flex-wrap: wrap;
            margin-top: 32px;
            gap: 12px;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .project-image img,
        .project-title :global(svg) {
            transition: none;
        }

        .project-link:hover .project-image img,
        .project-link:hover .project-title :global(svg) {
            transform: none;
        }
    }
</style>
