---
import FixedWidthLayout from "@/layouts/FixedWidthLayout.astro";
import { Portfolios } from "@/data/portfolios";
import { imageDimensions } from "@/data/image-dimensions";
import { MdArrowOutward } from "react-icons/md";

const projectYears = Portfolios.flatMap(
    (project) => project.year?.match(/\d{4}/g)?.map(Number) ?? [],
);
const yearRange = projectYears.length
    ? `${Math.min(...projectYears)}–${Math.max(...projectYears)}`
    : undefined;
---

<FixedWidthLayout
    title="Portfolio | Ping Cheng - Software Development Projects"
    description="Explore Ping Cheng's portfolio showcasing modern web applications, full-stack projects, and software solutions using Node.js, TypeScript, React, and cloud technologies."
    keywords="Ping Cheng Portfolio,Software Development Projects,Web Applications,Full Stack Developer,Node.js Projects,TypeScript Applications,React Projects,Cloud Solutions,Enterprise Software,Melbourne Developer"
    ogTitle="Portfolio | Ping Cheng - Software Development Projects"
    ogDescription="Discover innovative software solutions and web applications developed by Ping Cheng. Showcasing expertise in modern technologies and full-stack development."
    ogUrl="https://www.pingchengtech.com/portfolio"
    twitterCard="summary_large_image"
    twitterTitle="Portfolio | Ping Cheng - Software Development Projects"
    twitterDescription="Discover innovative software solutions and web applications developed by Ping Cheng."
>
    <main class="portfolio-page">
        <header class="portfolio-intro animate-fade-in">
            <div class="intro-topline">
                <p class="eyebrow studio-eyebrow">Selected work</p>
                {yearRange && <p class="year-range">{yearRange}</p>}
            </div>
            <h1>Portfolio</h1>
            <p class="intro-text">
                A selection of things I’ve built, from everyday tools to
                platforms for learning and work.
            </p>
        </header>

        <section aria-label="Projects">
            <div class="collection-heading animate-fade-in animate-delay-100">
                <p>Independent projects &amp; collaborations</p>
                <span>
                    {Portfolios.length.toString().padStart(2, "0")} projects
                </span>
            </div>
            <div class="project-grid">
                {
                    Portfolios.map((project, index) => (
                        <article
                            class:list={[
                                "project",
                                "animate-fade-in",
                                { "project-featured": index === 0 },
                            ]}
                            style={{
                                "--entrance-delay": `${Math.min(80 + index * 80, 240)}ms`,
                            }}
                        >
                            <a
                                class="project-link"
                                href={`/portfolio/${project.slug}`}
                                aria-labelledby={`project-${project.slug}`}
                            >
                                <div class="project-image">
                                    <img
                                        src={project.coverImage}
                                        alt={`Cover image for ${project.name}`}
                                        {...imageDimensions[project.coverImage]}
                                        loading={index === 0 ? "eager" : "lazy"}
                                        decoding="async"
                                    />
                                </div>
                                <div class="project-content">
                                    <span class="project-number editorial-label">
                                        Project{" "}
                                        {String(index + 1).padStart(2, "0")}
                                    </span>
                                    {index === 0 && (
                                        <p class="eyebrow studio-eyebrow featured-label">
                                            Latest project
                                        </p>
                                    )}
                                    <div class="project-meta">
                                        <span>{project.projectRole}</span>
                                        {project.year && (
                                            <span class="project-year">
                                                {project.year.replace(
                                                    /-/g,
                                                    "–",
                                                )}
                                            </span>
                                        )}
                                    </div>
                                    <div class="project-title">
                                        <h2 id={`project-${project.slug}`}>
                                            {project.name}
                                        </h2>
                                        <MdArrowOutward
                                            size={22}
                                            aria-hidden="true"
                                        />
                                    </div>
                                    <p class="project-description">
                                        {project.shortDescription}
                                    </p>
                                    <span
                                        class="view-project"
                                        aria-hidden="true"
                                    >
                                        View project
                                        <MdArrowOutward size={16} />
                                    </span>
                                </div>
                            </a>
                        </article>
                    ))
                }
            </div>
        </section>

        <aside
            class="portfolio-outro animate-fade-in animate-delay-300"
            aria-label="About the developer"
        >
            <div>
                <h2>The person behind the projects</h2>
                <p>More about my background and what I’m exploring now.</p>
            </div>
            <a href="/about">
                About me
                <MdArrowOutward size={18} aria-hidden="true" />
            </a>
        </aside>
    </main>
</FixedWidthLayout>

<style>
    .portfolio-page {
        padding: var(--page-space) 0 48px;
    }
    .intro-topline,
    .collection-heading,
    .project-meta,
    .project-title,
    .portfolio-outro {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 16px;
    }
    .year-range,
    .collection-heading,
    .project-meta {
        font-family: var(--font-code);
        font-size: 11px;
        color: var(--color-text-secondary);
    }
    .year-range,
    .project-year {
        white-space: nowrap;
    }
    h1 {
        margin-top: 28px;
        font-family: var(--font-display);
        font-size: clamp(48px, 6.5vw, 76px);
        font-weight: 400;
        line-height: 1.1;
        letter-spacing: -0.055em;
    }
    .intro-text {
        max-width: 44ch;
        margin-top: 24px;
        font-size: clamp(19px, 2.4vw, 23px);
        line-height: 1.65;
        letter-spacing: -0.025em;
    }
    .portfolio-intro {
        padding-bottom: 64px;
    }
    .collection-heading {
        padding: 20px 0;
        border-block: 1px solid var(--color-border);
    }
    .project-link {
        display: grid;
        grid-template-columns: 180px minmax(0, 1fr);
        gap: 48px;
        padding: 36px 0;
        border-bottom: 1px solid var(--color-border);
        align-items: center;
    }
    .project-image {
        background: var(--color-card);
        border: 1px solid var(--color-border);
    }
    .project-image img {
        width: 100%;
        aspect-ratio: 3 / 4;
        object-fit: contain;
    }
    .project-content {
        min-width: 0;
    }
    .project-number {
        display: block;
        margin-bottom: 18px;
    }
    .featured-label {
        margin-bottom: 16px;
        font-size: 10px;
    }
    .project-meta {
        flex-wrap: wrap;
        gap: 8px;
    }
    .project-title {
        align-items: center;
        margin-top: 12px;
    }
    .project-title h2 {
        font-family: var(--font-display);
        font-weight: 400;
        font-size: clamp(28px, 3vw, 38px);
        letter-spacing: -0.035em;
        line-height: 1.2;
    }
    .project-title :global(svg) {
        flex-shrink: 0;
        color: var(--color-accent);
    }
    .project-description {
        max-width: 58ch;
        margin-top: 14px;
        color: var(--color-text-secondary);
        line-height: 1.8;
    }
    .view-project {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        min-height: 44px;
        margin-top: 12px;
        font-size: 12px;
        text-decoration: underline;
        text-underline-offset: 5px;
        text-decoration-color: var(--color-border);
    }
    .view-project :global(svg) {
        display: none;
    }
    .project-link:hover .view-project {
        text-decoration-color: currentColor;
    }
    .project-featured .project-link {
        grid-template-columns: 260px minmax(0, 1fr);
        padding-block: 40px;
    }
    .portfolio-outro {
        padding-top: 40px;
        align-items: center;
    }
    .portfolio-outro h2 {
        font-size: 17px;
        font-weight: 500;
    }
    .portfolio-outro p {
        margin-top: 8px;
        color: var(--color-text-secondary);
        font-size: 14px;
    }
    .portfolio-outro a {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        min-height: 44px;
        font-size: 13px;
        flex-shrink: 0;
    }
    @media (max-width: 700px) {
        .portfolio-intro {
            padding-bottom: 36px;
        }
        .project-link,
        .project-featured .project-link {
            grid-template-columns: 88px minmax(0, 1fr);
            align-items: start;
            gap: 20px;
            padding-block: 28px;
        }
        .project-title h2 {
            font-size: 25px;
        }
        .project-number {
            margin-bottom: 10px;
        }
        .project-meta {
            font-size: 10px;
        }
        .project-description {
            font-size: 14px;
        }
        .featured-label {
            font-size: 9px;
            letter-spacing: 0.04em;
        }
        .collection-heading {
            flex-wrap: wrap;
            gap: 8px;
        }
        .portfolio-outro {
            flex-wrap: wrap;
        }
    }
</style>
