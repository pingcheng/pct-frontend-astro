---
import FixedWidthLayout from "@/layouts/FixedWidthLayout.astro";
import { Portfolios } from "@/data/portfolios";
import { imageDimensions } from "@/data/image-dimensions";
import { MdArrowForward } from "react-icons/md";
---

<FixedWidthLayout
    title="Portfolio | Ping Cheng"
    description="Things I’ve built, from everyday tools to platforms for learning and work."
    ogTitle="Portfolio | Ping Cheng"
    ogDescription="Things I’ve built, from everyday tools to platforms for learning and work."
    ogUrl="https://www.pingchengtech.com/portfolio"
    twitterCard="summary_large_image"
    twitterTitle="Portfolio | Ping Cheng"
    twitterDescription="Things I’ve built, from everyday tools to platforms for learning and work."
>
    <main class="portfolio-page">
        <header class="portfolio-intro animate-fade-in">
            <h1>Portfolio</h1>
            <p class="intro-text">
                A selection of things I’ve built, from everyday tools to
                platforms for learning and work.
            </p>
        </header>

        <section class="project-list" aria-label="Projects">
            <div class="project-grid">
                {
                    Portfolios.map((project, index) => (
                        <article
                            class:list={[
                                "project",
                                "animate-fade-in",
                                { "project-featured": index === 0 },
                            ]}
                            style={{
                                "--entrance-delay": `${Math.min(80 + index * 80, 240)}ms`,
                            }}
                        >
                            <a
                                class="project-link"
                                href={`/portfolio/${project.slug}`}
                                aria-labelledby={`project-${project.slug}`}
                            >
                                <div class="project-image">
                                    <img
                                        src={project.coverImage}
                                        alt={`Cover image for ${project.name}`}
                                        {...imageDimensions[project.coverImage]}
                                        loading={index === 0 ? "eager" : "lazy"}
                                        decoding="async"
                                    />
                                </div>
                                <div class="project-content">
                                    <div class="project-meta">
                                        <span>{project.projectRole}</span>
                                        {project.year && (
                                            <span class="project-year">
                                                {project.year.replace(
                                                    /-/g,
                                                    "–",
                                                )}
                                            </span>
                                        )}
                                    </div>
                                    <div class="project-title">
                                        <h2
                                            id={`project-${project.slug}`}
                                            style={{
                                                "view-transition-name": `project-title-${project.slug}`,
                                            }}
                                        >
                                            {project.name}
                                        </h2>
                                        <MdArrowForward
                                            size={22}
                                            aria-hidden="true"
                                        />
                                    </div>
                                    <p class="project-description">
                                        {project.shortDescription}
                                    </p>
                                </div>
                            </a>
                        </article>
                    ))
                }
            </div>
        </section>
    </main>
</FixedWidthLayout>

<style>
    .portfolio-page {
        padding: var(--page-space) 0 48px;
    }
    .project-meta,
    .project-title {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 16px;
    }
    .project-meta {
        font-family: var(--font-code);
        font-size: 11px;
        color: var(--color-text-secondary);
    }
    .project-year {
        white-space: nowrap;
    }
    h1 {
        font-family: var(--font-display);
        font-size: clamp(48px, 6.5vw, 76px);
        font-weight: 400;
        line-height: 1.1;
        letter-spacing: -0.055em;
    }
    .intro-text {
        max-width: 44ch;
        margin-top: 24px;
        font-size: clamp(19px, 2.4vw, 23px);
        line-height: 1.65;
        letter-spacing: -0.025em;
    }
    .portfolio-intro {
        padding-bottom: 64px;
    }
    .project-list {
        border-top: 1px solid var(--color-border);
    }
    .project-link {
        display: grid;
        grid-template-columns: 180px minmax(0, 1fr);
        gap: 48px;
        padding: 36px 0;
        border-bottom: 1px solid var(--color-border);
        align-items: center;
    }
    .project:last-child .project-link {
        border-bottom: 0;
    }
    .project-image {
        background: var(--color-card);
        border: 1px solid var(--color-border);
        transition:
            transform var(--dur-medium) var(--ease-out),
            box-shadow var(--dur-medium) var(--ease-out),
            border-color var(--dur-fast) var(--ease-out);
    }
    .project-title :global(svg) {
        transition: transform var(--dur-fast) var(--ease-out);
    }
    @media (hover: hover) {
        .project-link:hover .project-image {
            transform: translateY(-4px);
            border-color: var(--color-text-secondary);
            box-shadow: 0 14px 24px -18px rgb(0 0 0 / 0.5);
        }
        .project-link:hover .project-title :global(svg) {
            transform: translateX(3px);
        }
    }
    .project-image img {
        width: 100%;
        aspect-ratio: 3 / 4;
        object-fit: contain;
    }
    .project-content {
        min-width: 0;
    }
    .project-meta {
        flex-wrap: wrap;
        gap: 8px;
    }
    .project-title {
        align-items: center;
        margin-top: 12px;
    }
    .project-title h2 {
        font-family: var(--font-display);
        font-weight: 400;
        font-size: clamp(28px, 3vw, 38px);
        letter-spacing: -0.035em;
        line-height: 1.2;
    }
    .project-title :global(svg) {
        flex-shrink: 0;
        color: var(--color-accent);
    }
    .project-description {
        max-width: 58ch;
        margin-top: 14px;
        color: var(--color-text-secondary);
        line-height: 1.8;
    }
    .project-featured .project-link {
        grid-template-columns: 260px minmax(0, 1fr);
        padding-block: 40px;
    }
    @media (max-width: 700px) {
        .portfolio-intro {
            padding-bottom: 36px;
        }
        .project-link,
        .project-featured .project-link {
            grid-template-columns: 88px minmax(0, 1fr);
            align-items: start;
            gap: 20px;
            padding-block: 28px;
        }
        .project-title h2 {
            font-size: 25px;
        }
        .project-meta {
            font-size: 10px;
        }
        .project-description {
            font-size: 14px;
        }
    }
</style>
