---
import FixedWidthLayout from "@/layouts/FixedWidthLayout.astro";
import { Portfolios } from "@/data/portfolios";
import { imageDimensions } from "@/data/image-dimensions";
import type { Portfolio } from "@/models/Portfolio/Portfolio";
import { MdArrowBack, MdArrowOutward } from "react-icons/md";

export function getStaticPaths() {
    return Portfolios.map((portfolio) => ({
        params: { slug: portfolio.slug },
        props: { portfolio },
    }));
}

interface Props {
    portfolio: Portfolio;
}

const { portfolio } = Astro.props;
const screenshots = portfolio.screenshots.length
    ? portfolio.screenshots
    : [portfolio.coverImage];
const projectIndex = Portfolios.findIndex(
    (project) => project.slug === portfolio.slug,
);
const nextProject = Portfolios[(projectIndex + 1) % Portfolios.length];
---

<FixedWidthLayout
    title={`Portfolio - ${portfolio.name}`}
    description={portfolio.longDescription}
    ogTitle={`Portfolio - ${portfolio.name}`}
    ogUrl={new URL(`/portfolio/${portfolio.slug}`, Astro.site).href}
    ogImage={portfolio.coverImage}
    twitterImage={portfolio.coverImage}
>
    <main class="project-page">
        <header class="project-header animate-fade-in">
            <a class="back-link" href="/portfolio">
                <MdArrowBack size={16} aria-hidden="true" />
                Back to portfolio
            </a>
            <h1
                style={{
                    "view-transition-name": `project-title-${portfolio.slug}`,
                }}
            >
                {portfolio.name}
            </h1>
            <p class="project-description">{portfolio.longDescription}</p>
        </header>

        <div class="project-summary animate-fade-in animate-delay-100">
            <aside class="project-details" aria-label="Project details">
                <dl>
                    <div>
                        <dt>Role</dt>
                        <dd>{portfolio.projectRole}</dd>
                    </div>
                    {
                        portfolio.year && (
                            <div>
                                <dt>Year</dt>
                                <dd>{portfolio.year.replace(/-/g, "–")}</dd>
                            </div>
                        )
                    }
                    <div>
                        <dt>Project</dt>
                        <dd>{portfolio.workplace}</dd>
                    </div>
                    {
                        portfolio.url && (
                            <div>
                                <dt>Website</dt>
                                <dd>
                                    <a
                                        class="site-link"
                                        href={portfolio.url}
                                        target="_blank"
                                        rel="noopener noreferrer"
                                    >
                                        {new URL(portfolio.url).hostname}
                                        <MdArrowOutward
                                            size={15}
                                            aria-hidden="true"
                                        />
                                    </a>
                                </dd>
                            </div>
                        )
                    }
                    <div>
                        <dt>Team</dt>
                        <dd>
                            <ul class="team-list" role="list">
                                {
                                    portfolio.members.map((member) => (
                                        <li>{member}</li>
                                    ))
                                }
                            </ul>
                        </dd>
                    </div>
                </dl>
            </aside>
        </div>

        <div class="project-copy">
            <section class="development" aria-labelledby="development-title">
                <h2 id="development-title">
                    <span aria-hidden="true">01 / </span>Development
                </h2>
                <ul class="work-list" role="list">
                    {portfolio.roleDescription.map((line) => <li>{line}</li>)}
                </ul>
            </section>
        </div>

        <section
            class="screenshots-section"
            aria-labelledby="screenshots-title"
        >
            <h2
                id="screenshots-title"
                class="animate-fade-in animate-delay-200"
            >
                <span aria-hidden="true">02 / </span>Screenshots
            </h2>
            <div class="screenshot-grid">
                {
                    screenshots.map((src, index) => (
                        <figure>
                            <a
                                class="screenshot-link animate-fade-in"
                                style={{
                                    "--entrance-delay": `${Math.min(160 + index * 80, 240)}ms`,
                                }}
                                href={src}
                                target="_blank"
                                rel="noopener noreferrer"
                                aria-label={`Open screenshot ${index + 1} of ${portfolio.name} at full size`}
                            >
                                <img
                                    src={src}
                                    alt={`Screenshot ${index + 1} of ${portfolio.name}`}
                                    {...imageDimensions[src]}
                                    loading={index === 0 ? "eager" : "lazy"}
                                    decoding="async"
                                />
                            </a>
                            <figcaption>
                                <span>
                                    FIG {String(index + 1).padStart(2, "0")}
                                </span>{" "}
                                {portfolio.screenshotCaptions?.[index] ??
                                    `${portfolio.name} · Screen ${index + 1}`}
                            </figcaption>
                        </figure>
                    ))
                }
            </div>
        </section>

        <nav
            class="project-navigation animate-fade-in animate-delay-300"
            aria-label="Project navigation"
        >
            <a href="/portfolio">
                <MdArrowBack size={16} aria-hidden="true" />
                All projects
            </a>
            {
                nextProject && nextProject.slug !== portfolio.slug && (
                    <a
                        class="next-project"
                        href={`/portfolio/${nextProject.slug}`}
                    >
                        <span>Next: {nextProject.name}</span>
                        <MdArrowOutward size={16} aria-hidden="true" />
                    </a>
                )
            }
        </nav>
    </main>
</FixedWidthLayout>

<style>
    .project-page {
        padding: 40px 0 56px;
    }
    .back-link {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        min-height: 44px;
        font-family: var(--font-code);
        font-size: 11px;
        color: var(--color-text-secondary);
        --arrow-x: -2px;
        --arrow-y: 0px;
    }
    .project-header {
        max-width: 820px;
    }
    h1 {
        margin-top: 32px;
        font-family: var(--font-display);
        font-weight: 400;
        font-size: clamp(40px, 5.8vw, 68px);
        line-height: 1.08;
        letter-spacing: -0.045em;
        overflow-wrap: anywhere;
    }
    .project-description {
        max-width: var(--reading-width);
        margin-top: 28px;
        font-size: clamp(18px, 2vw, 21px);
        line-height: 1.8;
        color: var(--color-text-secondary);
        text-wrap: pretty;
    }
    .project-summary {
        margin-block: 40px 56px;
        padding-block: 24px;
        border-block: 1px solid var(--color-border);
    }
    dl {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 28px 36px;
    }
    dt {
        margin-bottom: 8px;
        font-family: var(--font-code);
        font-size: 10px;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: var(--color-text-secondary);
    }
    dd {
        font-size: 13px;
        line-height: 1.8;
    }
    .team-list {
        list-style: none;
    }
    .site-link {
        overflow-wrap: anywhere;
        text-decoration: underline;
        text-underline-offset: 4px;
        text-decoration-color: var(--color-border);
    }
    .site-link :global(svg) {
        display: inline;
        vertical-align: -2px;
    }
    .development {
        display: grid;
        grid-template-columns: 200px minmax(0, 1fr);
        gap: 48px;
    }
    h2 {
        font-family: var(--font-code);
        font-size: 12px;
        font-weight: 400;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        line-height: 1.8;
    }
    h2 span {
        color: var(--color-accent);
    }
    .work-list {
        max-width: var(--reading-width);
        display: grid;
        gap: 12px;
        padding-left: 18px;
        list-style: square;
        font-size: 17px;
        line-height: 1.8;
    }
    .work-list li::marker {
        color: var(--color-accent);
        font-size: 10px;
    }
    .screenshots-section {
        margin-top: 56px;
        padding-top: 28px;
        border-top: 1px solid var(--color-border);
    }
    .screenshot-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 36px 28px;
        margin-top: 28px;
    }
    figure {
        min-width: 0;
    }
    figure:first-child {
        grid-column: 1 / -1;
    }
    .screenshot-link {
        display: block;
        background: var(--color-card);
        border: 1px solid var(--color-border);
        cursor: zoom-in;
    }
    .screenshot-link img {
        display: block;
        width: 100%;
        height: auto;
    }
    figcaption {
        margin-top: 12px;
        color: var(--color-text-secondary);
        font-size: 12px;
        line-height: 1.7;
    }
    figcaption span {
        font-family: var(--font-code);
        font-size: 10px;
        color: var(--color-accent);
        margin-right: 12px;
    }
    .project-navigation {
        display: flex;
        justify-content: space-between;
        gap: 16px 32px;
        flex-wrap: wrap;
        margin-top: 48px;
        padding-top: 24px;
        border-top: 1px solid var(--color-border);
        font-size: 13px;
    }
    .project-navigation a {
        display: inline-flex;
        gap: 8px;
        align-items: center;
        min-height: 44px;
    }
    .project-navigation :global(svg) {
        flex-shrink: 0;
    }
    .next-project {
        margin-left: auto;
    }
    @media (max-width: 700px) {
        .project-page {
            padding-top: 24px;
        }
        h1 {
            margin-top: 24px;
        }
        dl {
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 24px;
        }
        dl > div:last-child {
            grid-column: 1 / -1;
        }
        .project-summary {
            margin-block: 28px 36px;
        }
        .development {
            grid-template-columns: 1fr;
            gap: 20px;
        }
        .work-list {
            font-size: 16px;
        }
        .screenshots-section {
            margin-top: 36px;
        }
        .screenshot-grid {
            grid-template-columns: 1fr;
            gap: 28px;
        }
    }
</style>
