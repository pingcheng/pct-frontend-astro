---
import FixedWidthLayout from "@/layouts/FixedWidthLayout.astro";
import { Portfolios } from "@/data/portfolios";
import { imageDimensions } from "@/data/image-dimensions";
import type { Portfolio } from "@/models/Portfolio/Portfolio";
import { MdArrowBack, MdArrowOutward } from "react-icons/md";

export function getStaticPaths() {
    return Portfolios.map((portfolio) => ({
        params: { slug: portfolio.slug },
        props: { portfolio },
    }));
}

interface Props {
    portfolio: Portfolio;
}

const { portfolio } = Astro.props;
const screenshots = portfolio.screenshots.length
    ? portfolio.screenshots
    : [portfolio.coverImage];
const projectIndex = Portfolios.findIndex(
    (project) => project.slug === portfolio.slug,
);
const nextProject = Portfolios[(projectIndex + 1) % Portfolios.length];
---

<FixedWidthLayout
    title={`Portfolio - ${portfolio.name}`}
    description={portfolio.longDescription}
    ogTitle={`Portfolio - ${portfolio.name}`}
    ogUrl={new URL(`/portfolio/${portfolio.slug}`, Astro.site).href}
    ogImage={portfolio.coverImage}
    twitterImage={portfolio.coverImage}
>
    <main class="project-page">
        <header class="project-header animate-fade-in">
            <a class="back-link" href="/portfolio">
                <MdArrowBack size={16} aria-hidden="true" />
                Back to portfolio
            </a>
            <h1>{portfolio.name}</h1>
            <img
                class="project-cover"
                src={portfolio.coverImage}
                alt={`Cover image for ${portfolio.name}`}
                {...imageDimensions[portfolio.coverImage]}
                loading="eager"
                decoding="async"
            />
        </header>

        <div class="project-summary animate-fade-in animate-delay-100">
            <div class="project-copy">
                <p class="project-description">{portfolio.longDescription}</p>
                <section
                    class="development"
                    aria-labelledby="development-title"
                >
                    <h2 id="development-title">Development</h2>
                    <ul class="work-list" role="list">
                        {
                            portfolio.roleDescription.map((line) => (
                                <li>{line}</li>
                            ))
                        }
                    </ul>
                </section>
            </div>

            <aside class="project-details" aria-label="Project details">
                <dl>
                    <div>
                        <dt>Role</dt>
                        <dd>{portfolio.projectRole}</dd>
                    </div>
                    {
                        portfolio.year && (
                            <div>
                                <dt>Year</dt>
                                <dd>{portfolio.year.replace(/-/g, "–")}</dd>
                            </div>
                        )
                    }
                    <div>
                        <dt>Project</dt>
                        <dd>{portfolio.workplace}</dd>
                    </div>
                    {
                        portfolio.url && (
                            <div>
                                <dt>Website</dt>
                                <dd>
                                    <a
                                        class="site-link"
                                        href={portfolio.url}
                                        target="_blank"
                                        rel="noopener noreferrer"
                                    >
                                        {new URL(portfolio.url).hostname}
                                        <MdArrowOutward
                                            size={15}
                                            aria-hidden="true"
                                        />
                                    </a>
                                </dd>
                            </div>
                        )
                    }
                    <div>
                        <dt>Team</dt>
                        <dd>
                            <ul class="team-list" role="list">
                                {
                                    portfolio.members.map((member) => (
                                        <li>{member}</li>
                                    ))
                                }
                            </ul>
                        </dd>
                    </div>
                </dl>
            </aside>
        </div>

        <section
            class="screenshots-section"
            aria-labelledby="screenshots-title"
        >
            <h2
                id="screenshots-title"
                class="animate-fade-in animate-delay-200"
            >
                Screenshots
            </h2>
            <div class="screenshot-grid">
                {
                    screenshots.map((src, index) => (
                        <a
                            class="screenshot-link animate-fade-in"
                            style={{
                                animationDelay: `${Math.min(200 + index * 40, 400)}ms`,
                            }}
                            href={src}
                            target="_blank"
                            rel="noopener noreferrer"
                            aria-label={`Open screenshot ${index + 1} of ${portfolio.name} at full size`}
                        >
                            <img
                                src={src}
                                alt={`Screenshot ${index + 1} of ${portfolio.name}`}
                                {...imageDimensions[src]}
                                loading={index === 0 ? "eager" : "lazy"}
                                decoding="async"
                            />
                        </a>
                    ))
                }
            </div>
        </section>

        <nav
            class="project-navigation animate-fade-in animate-delay-300"
            aria-label="Project navigation"
        >
            <a href="/portfolio">
                <MdArrowBack size={16} aria-hidden="true" />
                All projects
            </a>
            {
                nextProject && nextProject.slug !== portfolio.slug && (
                    <a
                        class="next-project"
                        href={`/portfolio/${nextProject.slug}`}
                    >
                        <span>Next: {nextProject.name}</span>
                        <MdArrowOutward size={16} aria-hidden="true" />
                    </a>
                )
            }
        </nav>
    </main>
</FixedWidthLayout>

<style>
    .project-page {
        max-width: 984px;
        margin: 0 auto;
        padding: 48px 0 40px;
    }

    .back-link,
    .project-navigation,
    .project-navigation a {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .back-link {
        width: fit-content;
        min-height: 44px;
        font-size: 13px;
        color: var(--color-text-secondary);
    }

    .project-header {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 96px;
        align-items: center;
        gap: 20px 32px;
    }

    .back-link {
        grid-column: 1 / -1;
    }

    .project-cover {
        width: 96px;
        height: 128px;
        object-fit: contain;
        border: 1px solid var(--color-border);
        border-radius: 4px;
        background: var(--color-card);
    }

    h1 {
        font-family: var(--font-display);
        font-size: clamp(36px, 4.5vw, 52px);
        font-weight: 400;
        line-height: 1.2;
        letter-spacing: -0.04em;
        overflow-wrap: anywhere;
    }

    .project-summary {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 250px;
        align-items: start;
        gap: 48px;
        margin-top: 28px;
    }

    .project-description {
        font-size: 17px;
        line-height: 1.8;
        text-wrap: pretty;
    }

    .development {
        margin-top: 28px;
    }

    h2 {
        font-size: 16px;
        font-weight: 600;
        line-height: 1.5;
        letter-spacing: -0.015em;
    }

    .work-list {
        display: grid;
        gap: 8px;
        margin-top: 12px;
        padding-left: 18px;
        list-style: disc;
        color: var(--color-text-secondary);
        font-size: 16px;
        line-height: 1.8;
    }

    .project-details {
        padding-left: 28px;
        border-left: 1px solid var(--color-border);
    }

    dl {
        display: grid;
        gap: 20px;
    }

    dt {
        margin-bottom: 5px;
        color: var(--color-text-secondary);
        font-size: 12px;
        font-family: var(--font-code);
    }

    dd {
        font-size: 14px;
        line-height: 1.7;
    }

    .site-link {
        overflow-wrap: anywhere;
        text-decoration: underline;
        text-decoration-color: var(--color-border);
        text-underline-offset: 4px;
    }

    .site-link :global(svg) {
        display: inline;
        vertical-align: -2px;
    }

    .team-list {
        display: grid;
        gap: 6px;
        list-style: none;
    }

    .screenshots-section {
        margin-top: 40px;
        padding-top: 28px;
        border-top: 1px solid var(--color-border);
    }

    .screenshot-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 20px;
        margin-top: 20px;
    }

    .screenshot-link {
        display: block;
        overflow: hidden;
        aspect-ratio: 8 / 5;
        border: 1px solid var(--color-border);
        border-radius: 4px;
        background: var(--color-card);
        cursor: zoom-in;
    }

    .screenshot-link:first-child {
        grid-column: 1 / -1;
    }

    .screenshot-link img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: top;
    }

    .project-navigation {
        justify-content: space-between;
        gap: 16px 32px;
        flex-wrap: wrap;
        margin-top: 32px;
        padding-top: 20px;
        border-top: 1px solid var(--color-border);
        font-size: 13px;
    }

    .project-navigation a {
        min-height: 44px;
    }

    .project-navigation :global(svg) {
        flex-shrink: 0;
    }

    .next-project {
        margin-left: auto;
    }

    a:hover {
        color: var(--color-text);
        text-decoration-color: currentColor;
    }

    a:focus-visible {
        outline: 2px solid var(--color-accent);
        outline-offset: 5px;
        border-radius: 2px;
    }

    @media (max-width: 700px) {
        .project-page {
            padding-top: 24px;
            padding-bottom: 16px;
        }

        .project-header {
            grid-template-columns: minmax(0, 1fr) 72px;
            gap: 16px;
        }

        .project-cover {
            width: 72px;
            height: 96px;
        }

        .project-summary {
            grid-template-columns: 1fr;
            gap: 28px;
            margin-top: 20px;
        }

        .project-details {
            padding: 24px 0 0;
            border-left: 0;
            border-top: 1px solid var(--color-border);
        }

        dl {
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 20px;
        }

        dl > div:last-child {
            grid-column: 1 / -1;
        }

        .site-link {
            font-size: 12px;
        }

        .screenshots-section {
            margin-top: 28px;
            padding-top: 24px;
        }

        .screenshot-grid {
            grid-template-columns: 1fr;
            gap: 16px;
        }
    }
</style>
