---
import FixedWidthLayout from "@/layouts/FixedWidthLayout.astro";
import { Portfolios } from "@/data/portfolios";
import { imageDimensions } from "@/data/image-dimensions";
import type { Portfolio } from "@/models/Portfolio/Portfolio";
import { MdArrowBack, MdArrowOutward } from "react-icons/md";

export function getStaticPaths() {
    return Portfolios.map((portfolio) => ({
        params: { slug: portfolio.slug },
        props: { portfolio },
    }));
}

interface Props {
    portfolio: Portfolio;
}

const { portfolio } = Astro.props;
const previewImage = portfolio.screenshots[0] ?? portfolio.coverImage;
const additionalScreenshots = portfolio.screenshots.slice(1);
const projectIndex = Portfolios.findIndex(
    (project) => project.slug === portfolio.slug,
);
const nextProject = Portfolios[(projectIndex + 1) % Portfolios.length];
---

<FixedWidthLayout
    title={`Portfolio - ${portfolio.name}`}
    description={portfolio.longDescription}
    ogTitle={`Portfolio - ${portfolio.name}`}
    ogUrl={new URL(`/portfolio/${portfolio.slug}`, Astro.site).href}
    ogImage={portfolio.coverImage}
    twitterImage={portfolio.coverImage}
>
    <main class="project-page">
        <header class="project-intro">
            <div class="intro-topline">
                <a class="back-link" href="/portfolio">
                    <MdArrowBack size={16} aria-hidden="true" />
                    Back to portfolio
                </a>
                {portfolio.year && (
                    <p class="project-year">
                        {portfolio.year.replace(/-/g, "–")}
                    </p>
                )}
            </div>
            <h1>{portfolio.name}</h1>
            <p class="intro-text">{portfolio.shortDescription}</p>
            <div class="project-facts">
                <dl>
                    <div>
                        <dt>My role</dt>
                        <dd>{portfolio.projectRole}</dd>
                    </div>
                    <div>
                        <dt>Context</dt>
                        <dd>{portfolio.workplace}</dd>
                    </div>
                </dl>
                {portfolio.url && (
                    <a
                        class="site-link"
                        href={portfolio.url}
                        target="_blank"
                        rel="noopener noreferrer"
                    >
                        Visit live site
                        <MdArrowOutward size={17} aria-hidden="true" />
                    </a>
                )}
            </div>
        </header>

        <div class="project-preview">
            <a
                class="screenshot-link"
                href={previewImage}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`Open full-size preview of ${portfolio.name}`}
            >
                <figure>
                    <div class="preview-frame">
                        <img
                            src={previewImage}
                            alt={`Screenshot 1 of ${portfolio.name}`}
                            {...imageDimensions[previewImage]}
                            loading="eager"
                            decoding="async"
                        />
                    </div>
                    <figcaption>
                        <span>Project preview</span>
                        <span>
                            View full image{" "}
                            <MdArrowOutward size={15} aria-hidden="true" />
                        </span>
                    </figcaption>
                </figure>
            </a>
        </div>

        <section class="detail-section" aria-labelledby="overview-title">
            <div class="section-label">
                <span class="section-number" aria-hidden="true">
                    01
                </span>
                <h2 id="overview-title">Overview</h2>
            </div>
            <p class="body-text">{portfolio.longDescription}</p>
        </section>

        <section class="detail-section" aria-labelledby="contribution-title">
            <div class="section-label">
                <span class="section-number" aria-hidden="true">
                    02
                </span>
                <h2 id="contribution-title">My contribution</h2>
            </div>
            <ul class="contribution-list" role="list">
                {portfolio.roleDescription.map((line) => (
                    <li>{line}</li>
                ))}
            </ul>
        </section>

        <section class="detail-section" aria-labelledby="team-title">
            <div class="section-label">
                <span class="section-number" aria-hidden="true">
                    03
                </span>
                <h2 id="team-title">Team</h2>
            </div>
            <ul class="team-list" role="list">
                {portfolio.members.map((member) => (
                    <li>{member}</li>
                ))}
            </ul>
        </section>

        {additionalScreenshots.length > 0 && (
            <section
                class="screenshots-section"
                aria-labelledby="screenshots-title"
            >
                <div class="screenshots-heading">
                    <h2 id="screenshots-title">More screenshots</h2>
                    <p>Open an image for a closer look</p>
                </div>
                <div class="screenshot-grid">
                    {additionalScreenshots.map((src, index) => (
                        <div>
                            <a
                                class="screenshot-link"
                                href={src}
                                target="_blank"
                                rel="noopener noreferrer"
                                aria-label={`Open screenshot ${index + 2} of ${portfolio.name} at full size`}
                            >
                                <figure>
                                    <div class="screenshot-frame">
                                        <img
                                            src={src}
                                            alt={`Screenshot ${index + 2} of ${portfolio.name}`}
                                            {...imageDimensions[src]}
                                            loading="lazy"
                                            decoding="async"
                                        />
                                    </div>
                                    <figcaption>
                                        <span>
                                            Screen{" "}
                                            {(index + 2)
                                                .toString()
                                                .padStart(2, "0")}
                                        </span>
                                        <span>
                                            View full image{" "}
                                            <MdArrowOutward
                                                size={15}
                                                aria-hidden="true"
                                            />
                                        </span>
                                    </figcaption>
                                </figure>
                            </a>
                        </div>
                    ))}
                </div>
            </section>
        )}

        <nav class="project-navigation" aria-label="Project navigation">
            <a class="all-projects" href="/portfolio">
                <MdArrowBack size={16} aria-hidden="true" />
                All projects
            </a>
            {nextProject && nextProject.slug !== portfolio.slug && (
                <a class="next-project" href={`/portfolio/${nextProject.slug}`}>
                    <span class="next-label">Next project</span>
                    <span class="next-title">
                        {nextProject.name}
                        <MdArrowOutward size={20} aria-hidden="true" />
                    </span>
                </a>
            )}
        </nav>
    </main>
</FixedWidthLayout>

<style>
    .project-page {
        max-width: 920px;
        margin: 0 auto;
        padding: 64px 0 56px;
    }

    .intro-topline,
    .back-link,
    .site-link,
    .project-facts,
    .section-label,
    figcaption,
    figcaption > span,
    .screenshots-heading,
    .project-navigation,
    .all-projects,
    .next-title {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .intro-topline,
    .project-facts,
    figcaption,
    .screenshots-heading,
    .project-navigation {
        justify-content: space-between;
    }

    .back-link,
    .project-year,
    dt,
    .section-number,
    figcaption,
    .screenshots-heading p,
    .next-label {
        font-size: 12px;
        color: var(--color-text-secondary);
    }

    .back-link,
    .site-link,
    .all-projects {
        min-height: 44px;
    }

    .project-year {
        font-variant-numeric: tabular-nums;
        flex-shrink: 0;
    }

    h1 {
        max-width: 820px;
        margin-top: 28px;
        font-size: clamp(40px, 5.5vw, 68px);
        font-weight: 500;
        line-height: 1.12;
        letter-spacing: -0.055em;
        text-wrap: balance;
        overflow-wrap: anywhere;
    }

    .intro-text {
        max-width: 680px;
        margin-top: 24px;
        font-size: clamp(19px, 2.4vw, 23px);
        line-height: 1.65;
        letter-spacing: -0.025em;
        text-wrap: pretty;
    }

    .project-facts {
        align-items: flex-end;
        flex-wrap: wrap;
        gap: 24px;
        margin-top: 32px;
        padding-top: 24px;
        border-top: 1px solid var(--color-border);
    }

    dl {
        display: flex;
        flex-wrap: wrap;
        gap: 20px 48px;
    }

    dt {
        margin-bottom: 8px;
    }

    dd {
        font-size: 14px;
        line-height: 1.6;
    }

    .site-link,
    .all-projects {
        font-size: 13px;
    }

    .site-link {
        text-decoration: underline;
        text-decoration-color: var(--color-border);
        text-underline-offset: 5px;
    }

    .project-preview {
        margin: 36px 0 44px;
    }

    .screenshot-link {
        display: block;
    }

    .preview-frame,
    .screenshot-frame {
        overflow: hidden;
        padding: 20px 20px 0;
        border: 1px solid var(--color-border);
        background: var(--color-card);
    }

    .preview-frame {
        aspect-ratio: 8 / 5;
    }

    .preview-frame img,
    .screenshot-frame img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: top;
        border: 1px solid var(--color-border);
        border-bottom: 0;
    }

    figcaption {
        padding-top: 12px;
        line-height: 1.6;
    }

    figcaption > span {
        gap: 5px;
    }

    .detail-section {
        display: grid;
        grid-template-columns: 200px minmax(0, 1fr);
        align-items: baseline;
        gap: 48px;
        padding: 32px 0;
        border-top: 1px solid var(--color-border);
    }

    .section-label {
        align-items: baseline;
        gap: 12px;
    }

    h2 {
        font-size: 14px;
        line-height: 1.5;
        font-weight: 500;
        letter-spacing: -0.015em;
    }

    .section-number {
        font-variant-numeric: tabular-nums;
    }

    .body-text,
    .contribution-list,
    .team-list {
        color: var(--color-text-secondary);
        font-size: 15px;
        line-height: 1.8;
        text-wrap: pretty;
    }

    .contribution-list,
    .team-list {
        display: grid;
        gap: 8px;
        list-style: none;
    }

    .contribution-list li {
        position: relative;
        padding-left: 18px;
    }

    .contribution-list li::before {
        content: "·";
        position: absolute;
        left: 0;
        color: var(--color-text);
    }

    .screenshots-section {
        padding-top: 32px;
        border-top: 1px solid var(--color-border);
    }

    .screenshots-heading {
        align-items: baseline;
        flex-wrap: wrap;
        gap: 8px 24px;
        margin-bottom: 24px;
    }

    .screenshot-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 28px 24px;
    }

    .screenshot-grid > div:only-child {
        grid-column: 1 / -1;
    }

    .screenshot-frame {
        aspect-ratio: 8 / 5;
        padding: 12px 12px 0;
    }

    .project-navigation {
        align-items: center;
        margin-top: 44px;
        padding: 28px 0;
        border-top: 1px solid var(--color-border);
        gap: 24px;
    }

    .next-project {
        max-width: 65%;
        text-align: right;
    }

    .next-label {
        display: block;
        margin-bottom: 8px;
    }

    .next-title {
        justify-content: flex-end;
        font-size: 20px;
        font-weight: 500;
        line-height: 1.4;
        letter-spacing: -0.025em;
    }

    .next-title :global(svg),
    .all-projects :global(svg) {
        flex-shrink: 0;
    }

    a:hover,
    .screenshot-link:hover figcaption {
        color: var(--color-text);
        text-decoration-color: currentColor;
    }

    a:focus-visible {
        outline: 2px solid var(--color-accent);
        outline-offset: 6px;
        border-radius: 2px;
    }

    @media (max-width: 700px) {
        .project-page {
            padding-top: 32px;
            padding-bottom: 12px;
        }

        h1 {
            margin-top: 20px;
        }

        .project-facts {
            margin-top: 24px;
            gap: 12px;
        }

        dl {
            gap: 16px 28px;
        }

        .project-preview {
            margin: 24px 0 32px;
        }

        .preview-frame {
            padding: 10px 10px 0;
        }

        .detail-section {
            grid-template-columns: 1fr;
            gap: 20px;
            padding: 28px 0;
        }

        .screenshot-grid {
            grid-template-columns: 1fr;
            gap: 24px;
        }

        .project-navigation {
            flex-wrap: wrap;
            align-items: flex-start;
            margin-top: 32px;
        }

        .next-project {
            max-width: 100%;
            margin-left: auto;
        }

        .next-title {
            font-size: 18px;
        }
    }
</style>
