---
import FixedWidthLayout from "@/layouts/FixedWidthLayout.astro";
import StudioScene from "@/components/StudioScene/StudioScene.astro";
import { Portfolios } from "@/data/portfolios";
import { imageDimensions } from "@/data/image-dimensions";
import { Avatar } from "@/components/Avatar/Avatar";
import StructuredData from "@/components/StructuredData/StructuredData.astro";
import { profile, socialUrls } from "@/data/profile";
import { URLS } from "@/constants/urls";

const roleDescription = `${profile.currentRole} at ${profile.company}`;
---

<FixedWidthLayout
    title="Ping Cheng"
    description={`Ping Cheng - ${roleDescription}. Software engineer in Melbourne working with Node, TypeScript, and Java.`}
    keywords="Ping Cheng,Principal Engineer,Software Engineer,Melbourne,Node,TypeScript,PHP,Java,Linux,REA Group,PropTrack,Web Development,Digital Solutions"
    ogTitle="Ping Cheng"
    ogDescription={`${roleDescription}. Software engineer in Melbourne working with Node, TypeScript, and Java.`}
    ogUrl="https://www.pingchengtech.com"
    ogType="profile"
    twitterCard="summary"
    twitterTitle="Ping Cheng"
    twitterDescription={`${roleDescription}. Software engineer in Melbourne.`}
>
    <StructuredData
        type="person"
        person={{
            name: profile.fullName,
            jobTitle: profile.currentRole,
            url: URLS.WEBSITE.BASE,
            image: URLS.ASSETS.APPLE_ICON,
            sameAs: [socialUrls.github, socialUrls.linkedin],
            worksFor: { name: profile.company, url: URLS.COMPANY.REA_GROUP },
            knowsAbout: [
                "Node.js",
                "TypeScript",
                "JavaScript",
                "PHP",
                "Java",
                "Linux",
                "React",
                "Vue.js",
                "AWS",
                "Docker",
                "MySQL",
                "Redis",
            ],
            address: {
                addressLocality: "Melbourne",
                addressRegion: "Victoria",
                addressCountry: "Australia",
            },
        }}
    />
    <StructuredData
        type="website"
        website={{
            name: "Ping Cheng Tech",
            url: URLS.WEBSITE.BASE,
            description: `Personal website of Ping Cheng, ${roleDescription}`,
            author: { name: profile.fullName, url: URLS.WEBSITE.BASE },
        }}
    />

    <main class="home-page">
        <section class="home-hero" aria-labelledby="home-title">
            <div class="hero-copy">
                <p class="studio-eyebrow">A personal corner of the internet</p>
                <h1 id="home-title">
                    <span>Hey, I’m</span>
                    {profile.fullName}<span class="name-period">.</span>
                </h1>
                <p class="hero-intro">
                    I like making things that are useful.<br
                        class="desktop-break"
                    /> And figuring things out along the way.
                </p>
                <p class="hero-description">
                    I’m a software engineer in Melbourne, exploring coding
                    agents, building personal tools, and tinkering with everyday
                    life.
                </p>
                <a href="/about" class="studio-link"
                    >A little more about me <span aria-hidden="true">↗</span></a
                >
            </div>
            <div class="studio-vignette">
                <div class="portrait-note">
                    <Avatar width={72} height={72} client:load />
                    <div>
                        <span class="note-greeting">Hello from</span><span
                            class="note-location">Melbourne, Australia</span>
                    </div>
                </div>
                <div class="scene-frame"><StudioScene /></div>
                <p class="scene-caption">
                    <span aria-hidden="true">+</span> A little space to think &amp;
                    build
                </p>
            </div>
        </section>

        <section class="currently-section" aria-labelledby="currently-title">
            <h2 id="currently-title" class="studio-eyebrow">These days</h2>
            <div class="currently-copy">
                <p>
                    <span class="current-role">{roleDescription}</span>, helping
                    shape technical direction and exploring practical ways to
                    build with coding agents.
                </p>
                <p>
                    Off the clock, you’ll find me experimenting with home
                    automation, solar and battery systems, learning tools, or a
                    good puzzle.
                </p>
            </div>
        </section>

        <section class="selected-section" aria-labelledby="selected-title">
            <div class="section-heading">
                <div>
                    <p class="studio-eyebrow">From the workbench</p><h2
                        id="selected-title"
                    >
                        A few things I’ve built
                    </h2>
                </div>
                <a href="/portfolio" class="studio-link"
                    >All projects <span aria-hidden="true">↗</span></a
                >
            </div>
            <div class="selected-projects">
                {
                    Portfolios.slice(0, 2).map((project, index) => (
                        <article class="selected-project">
                            <a
                                href={`/portfolio/${project.slug}`}
                                class="selected-project-link"
                                aria-labelledby={`home-project-${project.slug}`}
                            >
                                <div class="selected-image">
                                    <img
                                        src={project.coverImage}
                                        alt={`Cover image for ${project.name}`}
                                        {...imageDimensions[project.coverImage]}
                                        loading="lazy"
                                        decoding="async"
                                    />
                                </div>
                                <div class="selected-copy">
                                    <p class="project-note">
                                        {index === 0
                                            ? "Latest project"
                                            : project.workplace}{" "}
                                        <span>
                                            {project.year?.replace(/-/g, "–")}
                                        </span>
                                    </p>
                                    <h3 id={`home-project-${project.slug}`}>
                                        {project.name}{" "}
                                        <span aria-hidden="true">↗</span>
                                    </h3>
                                    <p>{project.shortDescription}</p>
                                </div>
                            </a>
                        </article>
                    ))
                }
            </div>
        </section>

        <section class="home-connect" aria-labelledby="connect-title">
            <div>
                <h2 id="connect-title">Always curious. Always building.</h2><p>
                    Find me elsewhere on the internet.
                </p>
            </div>
            <div class="connect-links">
                <a
                    href={socialUrls.github}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="studio-link"
                    >GitHub <span aria-hidden="true">↗</span></a
                ><a
                    href={socialUrls.linkedin}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="studio-link"
                    >LinkedIn <span aria-hidden="true">↗</span></a>
            </div>
        </section>
    </main>
</FixedWidthLayout>

<style>
    .home-page {
        padding-top: 76px;
    }
    .home-hero {
        display: grid;
        grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr);
        align-items: center;
        gap: 60px;
        padding-bottom: 76px;
    }
    h1 {
        margin-top: 25px;
        font-family: var(--font-display);
        font-weight: 400;
        font-size: clamp(60px, 7.3vw, 88px);
        letter-spacing: -0.065em;
        line-height: 1.05;
    }
    h1 > span:first-child {
        display: block;
        margin-bottom: 8px;
        font-family: "Inter", sans-serif;
        font-size: 26px;
        font-weight: 400;
        letter-spacing: -0.04em;
        line-height: 1.4;
    }
    .name-period {
        color: var(--color-accent);
    }
    .hero-intro {
        margin-top: 28px;
        font-size: 20px;
        line-height: 1.6;
        letter-spacing: -0.025em;
    }
    .hero-description {
        max-width: 49ch;
        margin-top: 17px;
        font-size: 16px;
        line-height: 1.8;
        color: var(--color-text-secondary);
    }
    .hero-copy > a {
        margin-top: 20px;
    }
    .studio-vignette {
        padding-top: 34px;
    }
    .portrait-note {
        display: flex;
        align-items: center;
        gap: 16px;
        margin: 0 0 18px 22px;
    }
    .portrait-note :global(img) {
        border: 1px solid var(--color-border);
    }
    .note-greeting,
    .note-location {
        display: block;
        font-size: 12px;
    }
    .note-greeting {
        color: var(--color-text-secondary);
    }
    .note-location {
        margin-top: 2px;
        font-weight: 500;
    }
    .scene-frame {
        padding: 18px 10px 14px;
        background: var(--color-card);
        clip-path: polygon(
            8px 0,
            calc(100% - 8px) 0,
            calc(100% - 8px) 8px,
            100% 8px,
            100% calc(100% - 8px),
            calc(100% - 8px) calc(100% - 8px),
            calc(100% - 8px) 100%,
            8px 100%,
            8px calc(100% - 8px),
            0 calc(100% - 8px),
            0 8px,
            8px 8px
        );
    }
    .scene-caption {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        margin-top: 14px;
        color: var(--color-text-secondary);
        font-family: var(--font-code);
        font-size: 10px;
    }
    .scene-caption span {
        color: var(--color-moss);
        font-size: 16px;
    }
    .currently-section {
        display: grid;
        grid-template-columns: 180px minmax(0, 1fr);
        gap: 48px;
        padding-block: 34px 40px;
        border-block: 1px solid var(--color-border);
    }
    .currently-section h2 {
        align-self: start;
        margin-top: 7px;
        color: var(--color-moss);
    }
    .currently-copy {
        max-width: 65ch;
    }
    .currently-copy p {
        font-size: 16px;
        line-height: 1.8;
        color: var(--color-text-secondary);
    }
    .currently-copy p + p {
        margin-top: 12px;
    }
    .current-role {
        color: var(--color-text);
    }
    .selected-section {
        padding-top: 60px;
    }
    .section-heading {
        display: flex;
        align-items: end;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 32px;
    }
    .section-heading h2 {
        margin-top: 12px;
        font-family: var(--font-display);
        font-size: 36px;
        letter-spacing: -0.04em;
        line-height: 1.25;
    }
    .selected-projects {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 40px;
    }
    .selected-image {
        display: flex;
        align-items: center;
        justify-content: center;
        height: 260px;
        padding: 24px;
        border: 1px solid var(--color-border);
        background: var(--color-card);
    }
    .selected-image img {
        height: 100%;
        max-width: 100%;
        width: auto;
        object-fit: contain;
    }
    .selected-project-link {
        display: block;
    }
    .selected-copy {
        padding-top: 18px;
    }
    .project-note {
        display: flex;
        justify-content: space-between;
        gap: 12px;
        font-family: var(--font-code);
        font-size: 11px;
        color: var(--color-text-secondary);
    }
    .selected-copy h3 {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-top: 10px;
        font-size: 19px;
        line-height: 1.4;
        font-weight: 500;
        letter-spacing: -0.025em;
    }
    .selected-copy h3 span {
        color: var(--color-accent);
        font-size: 18px;
    }
    .selected-copy > p:last-child {
        margin-top: 9px;
        color: var(--color-text-secondary);
        font-size: 16px;
        line-height: 1.75;
    }
    .home-connect {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
        padding-block: 36px 44px;
        margin-top: 56px;
        border-top: 1px solid var(--color-border);
    }
    .home-connect h2 {
        font-size: 17px;
        font-weight: 500;
        letter-spacing: -0.03em;
    }
    .home-connect p {
        margin-top: 4px;
        color: var(--color-text-secondary);
        font-size: 14px;
    }
    .connect-links {
        display: flex;
        gap: 26px;
    }
    @media (max-width: 900px) {
        .home-hero {
            gap: 32px;
        }
        .hero-intro {
            font-size: 18px;
        }
        .desktop-break {
            display: none;
        }
        .portrait-note {
            margin-left: 0;
            gap: 10px;
        }
        .note-location {
            font-size: 11px;
        }
    }
    @media (max-width: 700px) {
        .home-page {
            padding-top: 42px;
        }
        .home-hero {
            grid-template-columns: 1fr;
            gap: 32px;
            padding-bottom: 40px;
        }
        h1 {
            font-size: clamp(60px, 12vw, 78px);
        }
        h1 > span:first-child {
            font-size: 23px;
        }
        .hero-intro {
            font-size: 20px;
        }
        .studio-vignette {
            max-width: 350px;
            width: 100%;
            justify-self: center;
            padding-top: 0;
        }
        .portrait-note {
            margin-left: 12px;
        }
        .note-location {
            font-size: 12px;
        }
        .scene-frame {
            padding-inline: 20px;
        }
        .currently-section {
            grid-template-columns: 1fr;
            gap: 18px;
            padding-block: 28px;
        }
        .selected-section {
            padding-top: 40px;
        }
        .section-heading {
            flex-wrap: wrap;
            gap: 12px;
            margin-bottom: 24px;
        }
        .section-heading h2 {
            font-size: 31px;
        }
        .selected-projects {
            grid-template-columns: 1fr;
            gap: 32px;
        }
        .selected-image {
            height: 270px;
        }
        .home-connect {
            align-items: start;
            flex-direction: column;
            gap: 12px;
            padding-block: 28px;
            margin-top: 40px;
        }
    }
</style>
