---
import type { MarkdownInstance } from "astro";
import FixedWidthLayout from "@/layouts/FixedWidthLayout.astro";
import {
    containsCjk,
    formatPostDate,
    readingMinutes,
    type BlogFrontmatter,
} from "@/utils/blog";
import { MdArrowForward } from "react-icons/md";

const posts = Object.values(
    import.meta.glob<MarkdownInstance<BlogFrontmatter>>("./*.md", {
        eager: true,
    }),
).sort(
    (a, b) =>
        Date.parse(b.frontmatter.publishedAt) -
        Date.parse(a.frontmatter.publishedAt),
);
const canonical = new URL("/blog/", Astro.site).href;
---

<FixedWidthLayout
    title="Blog | Ping Cheng"
    description="Notes on software, useful tools, and the details that make them work."
    canonicalUrl={canonical}
    ogUrl={canonical}
>
    <main class="blog-page">
        <header class="blog-intro animate-fade-in">
            <h1>Blog</h1>
            <p class="intro-text">
                Notes on software, useful tools, and the details that make them
                work.
            </p>
        </header>
        <section class="post-list" aria-label="Blog posts">
            {posts.map((post, index) => (
                <article
                    class="post-entry animate-fade-in"
                    style={{
                        "--entrance-delay": `${Math.min(index * 80, 240)}ms`,
                    }}
                >
                    <div class="post-date">
                        <time datetime={post.frontmatter.publishedAt}>
                            {formatPostDate(post.frontmatter.publishedAt)}
                        </time>
                        <p class="studio-eyebrow post-topic">
                            {post.frontmatter.topic}
                        </p>
                    </div>
                    <div class="post-copy">
                        <h2
                            lang={
                                containsCjk(post.frontmatter.title)
                                    ? "zh-CN"
                                    : undefined
                            }
                        >
                            <a href={post.url?.replace(/\/*$/, "/")}>
                                <span>{post.frontmatter.title}</span>
                                <MdArrowForward
                                    size={22}
                                    aria-hidden="true"
                                />
                            </a>
                        </h2>
                        {post.frontmatter.description && (
                            <p
                                lang={
                                    containsCjk(post.frontmatter.description)
                                        ? "zh-CN"
                                        : undefined
                                }
                            >
                                {post.frontmatter.description}
                            </p>
                        )}
                        <span class="reading-time">
                            {readingMinutes(post.rawContent())} min read
                        </span>
                    </div>
                </article>
            ))}
        </section>
    </main>
</FixedWidthLayout>

<style>
    .blog-page {
        padding: var(--page-space) 0 48px;
    }
    .blog-intro {
        padding-bottom: 64px;
    }
    h1 {
        font-family: var(--font-display);
        font-size: clamp(48px, 6.5vw, 76px);
        font-weight: 400;
        line-height: 1.1;
        letter-spacing: -0.055em;
    }
    .intro-text {
        max-width: 44ch;
        margin-top: 24px;
        font-size: clamp(19px, 2.4vw, 23px);
        line-height: 1.65;
        letter-spacing: -0.01em;
        color: var(--color-text-secondary);
    }
    .post-list {
        border-top: 1px solid var(--color-border);
    }
    .post-entry {
        display: grid;
        grid-template-columns: 200px minmax(0, 1fr);
        gap: 48px;
        padding: 44px 0;
        border-bottom: 1px solid var(--color-border);
    }
    .post-entry:last-child {
        border-bottom: 0;
    }
    .post-date {
        padding-top: 10px;
    }
    .post-topic {
        margin-top: 10px;
        font-size: 11px;
        gap: 8px;
    }
    .post-date time,
    .reading-time {
        font-family: var(--font-code);
        color: var(--color-text-secondary);
        font-size: 11px;
    }
    h2 {
        font-family: var(--font-display);
        font-weight: 400;
        font-size: clamp(30px, 4vw, 44px);
        line-height: 1.2;
        letter-spacing: -0.035em;
    }
    h2:lang(zh) {
        letter-spacing: -0.01em;
        line-height: 1.3;
    }
    h2 a {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
    }
    h2 a :global(svg) {
        flex-shrink: 0;
        color: var(--color-accent);
        opacity: 0;
        transform: translateX(-4px);
        transition:
            opacity var(--dur-fast) var(--ease-out),
            transform var(--dur-fast) var(--ease-out);
    }
    @media (hover: hover) {
        h2 a:hover :global(svg),
        h2 a:focus-visible :global(svg) {
            opacity: 1;
            transform: translateX(3px);
        }
    }
    h2 a:hover {
        color: var(--color-accent);
    }
    .post-copy {
        min-width: 0;
    }
    .post-copy > p {
        max-width: 58ch;
        margin-top: 18px;
        color: var(--color-text-secondary);
        line-height: 1.85;
    }
    .reading-time {
        display: block;
        margin-top: 22px;
    }
    @media (max-width: 700px) {
        .blog-intro {
            padding-bottom: 36px;
        }
        .post-entry {
            grid-template-columns: minmax(0, 1fr);
            gap: 18px;
            padding-block: 28px;
        }
        .post-date {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 8px 16px;
            padding-top: 0;
        }
        .post-topic {
            margin-top: 0;
        }
        h2 a :global(svg) {
            display: none;
        }
    }
</style>
