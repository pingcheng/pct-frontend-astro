---
import type { MarkdownInstance } from "astro";
import FixedWidthLayout from "@/layouts/FixedWidthLayout.astro";
import {
    formatPostDate,
    readingMinutes,
    type BlogFrontmatter,
} from "@/utils/blog";

const posts = Object.values(
    import.meta.glob<MarkdownInstance<BlogFrontmatter>>("./*.md", {
        eager: true,
    }),
).sort(
    (a, b) =>
        Date.parse(b.frontmatter.publishedAt) -
        Date.parse(a.frontmatter.publishedAt),
);
const canonical = new URL("/blog/", Astro.site).href;
---

<FixedWidthLayout
    title="Blog | Ping Cheng"
    description="Notes on software, useful tools, and the details that make them work."
    canonicalUrl={canonical}
    ogUrl={canonical}
>
    <main class="blog-page">
        <header class="blog-intro animate-fade-in">
            <h1>Blog</h1>
            <p class="intro-text">
                Notes on software, useful tools, and the details that make them
                work.
            </p>
        </header>
        <section class="post-list" aria-label="Blog posts">
            {posts.map((post, index) => (
                <article
                    class="post-entry animate-fade-in"
                    style={{
                        "--entrance-delay": `${Math.min(index * 80, 240)}ms`,
                    }}
                >
                    <div class="post-date">
                        <time datetime={post.frontmatter.publishedAt}>
                            {formatPostDate(post.frontmatter.publishedAt)}
                        </time>
                    </div>
                    <div class="post-copy">
                        <h2>
                            <a href={post.url?.replace(/\/*$/, "/")}>
                                {post.frontmatter.title}
                            </a>
                        </h2>
                        <p>{post.frontmatter.description}</p>
                        <span class="reading-time">
                            {readingMinutes(post.rawContent())} min read
                        </span>
                    </div>
                </article>
            ))}
        </section>
    </main>
</FixedWidthLayout>

<style>
    .blog-page {
        padding: var(--page-space) 0 48px;
    }
    .blog-intro {
        padding-bottom: 64px;
    }
    h1 {
        font-family: var(--font-display);
        font-size: clamp(48px, 6.5vw, 76px);
        font-weight: 400;
        line-height: 1.1;
        letter-spacing: -0.055em;
    }
    .intro-text {
        max-width: 52ch;
        margin-top: 24px;
        color: var(--color-text-secondary);
    }
    .post-list {
        border-top: 1px solid var(--color-border);
    }
    .post-entry {
        display: grid;
        grid-template-columns: 180px minmax(0, 1fr);
        gap: 48px;
        padding: 44px 0;
        border-bottom: 1px solid var(--color-border);
    }
    .post-entry:last-child {
        border-bottom: 0;
    }
    .post-date {
        padding-top: 14px;
    }
    .post-date time,
    .reading-time {
        font-family: var(--font-code);
        color: var(--color-text-secondary);
        font-size: 11px;
    }
    h2 {
        font-family: var(--font-display);
        font-weight: 400;
        font-size: clamp(30px, 4vw, 44px);
        line-height: 1.2;
        letter-spacing: -0.035em;
    }
    h2 a:hover {
        color: var(--color-accent);
    }
    .post-copy {
        min-width: 0;
    }
    .post-copy > p {
        max-width: 58ch;
        margin-top: 18px;
        color: var(--color-text-secondary);
        line-height: 1.85;
    }
    .reading-time {
        display: block;
        margin-top: 22px;
    }
    @media (max-width: 700px) {
        .blog-intro {
            padding-bottom: 36px;
        }
        .post-entry {
            grid-template-columns: minmax(0, 1fr);
            gap: 22px;
            padding-block: 28px;
        }
        .post-date {
            padding-top: 0;
        }
    }
</style>
