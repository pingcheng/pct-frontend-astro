---
import FixedWidthLayout from "@/layouts/FixedWidthLayout.astro";
import { Avatar } from "@/components/Avatar/Avatar";
import StructuredData from "@/components/StructuredData/StructuredData.astro";
import { profile, socialUrls } from "@/data/profile";
import {
    mainFocus,
    earlierExperience,
    tinkeringInterests,
} from "@/data/skills";
import { workExperiences } from "@/data/work-experience";
import { URLS } from "@/constants/urls";

import { FaLinkedin, FaGithub } from "react-icons/fa";
import { MdArrowOutward, MdEmail } from "react-icons/md";

const links = [
    {
        url: socialUrls.github,
        text: "GitHub",
        ariaLabel: "Visit my GitHub profile",
        Icon: FaGithub,
    },
    {
        url: socialUrls.linkedin,
        text: "LinkedIn",
        ariaLabel: "Visit my LinkedIn profile",
        Icon: FaLinkedin,
    },
    {
        url: `mailto:${profile.email}`,
        text: "Email",
        ariaLabel: `Send email to ${profile.email}`,
        Icon: MdEmail,
    },
];

const allSkills = [
    ...mainFocus.skills,
    ...earlierExperience.skills,
    ...tinkeringInterests.skills,
];

const roleDescription = `${profile.currentRole} at ${profile.company}`;

const breadcrumbItems = [
    { name: "Home", url: URLS.WEBSITE.BASE },
    { name: "About", url: URLS.WEBSITE.ABOUT },
];
---

<FixedWidthLayout
    title="About Ping Cheng"
    description={`${profile.currentRole} at ${profile.company} focused on agentic engineering, technical direction, TypeScript, and agent harnesses, with a background in full-stack development and cloud infrastructure.`}
    keywords="Ping Cheng,Principal Engineer,Software Engineer,Melbourne,Agentic Engineering,Technical Direction,Agent Harnesses,Context Engineering,REA Group,PropTrack,TypeScript,System Design"
    ogTitle="About Ping Cheng"
    ogDescription={`${profile.currentRole} at ${profile.company} focused on agentic engineering, technical direction, and building with coding agents.`}
    ogUrl="https://www.pingchengtech.com/about"
    ogType="profile"
    twitterCard="summary"
    twitterTitle="About Ping Cheng"
    twitterDescription={`${profile.currentRole} at ${profile.company} focused on agentic engineering, technical direction, and building with coding agents.`}
>
    <StructuredData
        type="person"
        person={{
            name: profile.fullName,
            jobTitle: profile.currentRole,
            url: URLS.WEBSITE.BASE,
            image: URLS.ASSETS.APPLE_ICON,
            sameAs: [socialUrls.github, socialUrls.linkedin],
            worksFor: { name: profile.company, url: URLS.COMPANY.REA_GROUP },
            knowsAbout: allSkills,
            address: {
                addressLocality: "Melbourne",
                addressRegion: "Victoria",
                addressCountry: "Australia",
            },
            email: profile.email,
        }}
    />
    <StructuredData type="breadcrumb" breadcrumbItems={breadcrumbItems} />
    <StructuredData
        type="professionalService"
        professionalService={{
            name: "Software Development Services",
            description:
                "Full-stack web development, cloud solutions, and enterprise software development services specialising in Node.js, TypeScript, PHP, Java, and modern web technologies.",
            provider: { name: profile.fullName, url: URLS.WEBSITE.BASE },
            areaServed: "Melbourne, Australia",
            serviceType: "Software Development",
        }}
    />

    <main class="about-page">
        <header class="about-intro" aria-labelledby="about-title">
            <div class="intro-topline">
                <p class="eyebrow">A little about me</p>
                <p class="location">Melbourne, Australia</p>
            </div>
            <div class="intro-identity">
                <div>
                    <h1 id="about-title">{profile.fullName}</h1>
                    <p class="role">{roleDescription}</p>
                </div>
                <div class="portrait">
                    <Avatar
                        width={104}
                        height={104}
                        alt="Ping Cheng profile photo"
                        fallbackLabel="PC"
                        className="about-avatar"
                        client:load
                    />
                </div>
            </div>
            <p class="intro-text">
                I build software and help shape the technical direction behind
                it. These days, I’m focused on how coding agents change the way
                we work.
            </p>
            <nav class="profile-links" aria-label="Find me online">
                {links.map((link) => (
                    <a
                        href={link.url}
                        target={
                            link.url.startsWith("mailto:")
                                ? undefined
                                : "_blank"
                        }
                        rel={
                            link.url.startsWith("mailto:")
                                ? undefined
                                : "noopener noreferrer"
                        }
                        aria-label={link.ariaLabel}
                    >
                        <link.Icon size={16} aria-hidden="true" />
                        <span>{link.text}</span>
                        <MdArrowOutward size={14} aria-hidden="true" />
                    </a>
                ))}
            </nav>
        </header>

        <section class="about-section" aria-labelledby="focus-title">
            <div class="section-label">
                <span class="section-number" aria-hidden="true">
                    01
                </span>
                <h2 id="focus-title">Focus &amp; Interests</h2>
            </div>
            <div class="focus-content">
                <div class="focus-item">
                    <h3>Building with agents</h3>
                    <p>
                        I’m exploring agent harnesses, context engineering, and
                        practical ways to build with coding agents. TypeScript,
                        system design, and technical direction sit at the centre
                        of that work.
                    </p>
                </div>
                <div class="focus-item">
                    <h3>A full-stack foundation</h3>
                    <p>
                        My background spans web applications, cloud
                        infrastructure, and delivery, working with React,
                        Node.js, PHP, Java, and AWS. I’ve worked across
                        early-stage products and enterprise systems.
                    </p>
                    <a class="text-link" href="/portfolio">
                        Explore my projects
                        <MdArrowOutward size={16} aria-hidden="true" />
                    </a>
                </div>
                <div class="focus-item">
                    <h3>Outside of work</h3>
                    <p>
                        I tinker with home automation, solar and battery
                        systems, and personal tools. I also enjoy learning,
                        games, and a good puzzle.
                    </p>
                </div>
            </div>
        </section>

        <section class="about-section" aria-labelledby="experience-title">
            <div class="section-label">
                <span class="section-number" aria-hidden="true">
                    02
                </span>
                <h2 id="experience-title">Professional Experience</h2>
            </div>
            <div class="experience-list">
                {workExperiences.map(({ company, positions }) => (
                    <article class="company">
                        <div class="company-heading">
                            <h3>{company.name.replace(" - ", " · ")}</h3>
                            {company.linkedInUrl && (
                                <a
                                    href={company.linkedInUrl}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    aria-label={`${company.name} LinkedIn profile`}
                                >
                                    <MdArrowOutward
                                        size={17}
                                        aria-hidden="true"
                                    />
                                </a>
                            )}
                        </div>
                        <ul class="positions" role="list">
                            {positions.map((position) => (
                                <li
                                    class:list={[
                                        "position",
                                        {
                                            "position-current":
                                                position.endDate === "Present",
                                        },
                                    ]}
                                >
                                    <span class="position-name">
                                        {position.endDate === "Present" && (
                                            <span
                                                class="current-dot"
                                                aria-hidden="true"
                                            />
                                        )}
                                        {position.position}
                                    </span>
                                    <span class="position-dates">
                                        {position.startDate} –{" "}
                                        {position.endDate}
                                    </span>
                                </li>
                            ))}
                        </ul>
                        {positions.some(
                            (position) => position.description?.length,
                        ) && (
                            <details class="work-details">
                                <summary>More about this work</summary>
                                <div class="work-details-content">
                                    {positions
                                        .filter(
                                            (position) =>
                                                position.description?.length,
                                        )
                                        .map((position) => (
                                            <div class="role-details">
                                                <h4>{position.position}</h4>
                                                {position.description?.map(
                                                    (line) => {
                                                        if (
                                                            line.type ===
                                                            "break"
                                                        )
                                                            return null;
                                                        if (
                                                            line.type ===
                                                            "heading"
                                                        )
                                                            return (
                                                                <p class="detail-heading">
                                                                    {line.text}
                                                                </p>
                                                            );
                                                        if (
                                                            line.type ===
                                                            "bullet"
                                                        )
                                                            return (
                                                                <p class="detail-bullet">
                                                                    {line.text}
                                                                </p>
                                                            );
                                                        return (
                                                            <p>{line.text}</p>
                                                        );
                                                    },
                                                )}
                                            </div>
                                        ))}
                                </div>
                            </details>
                        )}
                    </article>
                ))}
            </div>
        </section>

        <section
            class="about-section contact-section"
            aria-labelledby="contact-title"
        >
            <div class="section-label">
                <span class="section-number" aria-hidden="true">
                    03
                </span>
                <h2 id="contact-title">Get in touch</h2>
            </div>
            <div class="contact-content">
                <p>Let’s connect.</p>
                <a class="contact-link" href={`mailto:${profile.email}`}>
                    {profile.email}
                    <MdArrowOutward size={20} aria-hidden="true" />
                </a>
            </div>
        </section>
    </main>
</FixedWidthLayout>

<style>
    .about-page {
        --about-muted: var(--color-text-secondary);
        --about-accent: var(--color-accent);
        max-width: 920px;
        margin: 0 auto;
        padding: 84px 0 56px;
    }

    .intro-topline,
    .intro-identity,
    .profile-links,
    .profile-links a,
    .company-heading,
    .position,
    .text-link,
    .contact-link {
        display: flex;
        align-items: center;
    }

    .intro-topline,
    .intro-identity {
        justify-content: space-between;
        gap: 24px;
    }

    .eyebrow,
    .location,
    .section-number {
        font-size: 12px;
        color: var(--about-muted);
    }

    .eyebrow {
        letter-spacing: 0.14em;
        text-transform: uppercase;
        font-weight: 500;
    }

    .intro-identity {
        margin-top: 35px;
    }

    h1 {
        font-size: clamp(44px, 6.5vw, 76px);
        line-height: 1.1;
        letter-spacing: -0.065em;
        font-weight: 500;
    }

    .role {
        margin-top: 16px;
        font-size: 16px;
        color: var(--about-muted);
    }

    .portrait {
        flex-shrink: 0;
        padding: 6px;
        border: 1px solid var(--color-border);
        border-radius: 50%;
    }

    .intro-text {
        max-width: 620px;
        margin-top: 32px;
        font-size: clamp(19px, 2.4vw, 23px);
        line-height: 1.65;
        letter-spacing: -0.025em;
        text-wrap: pretty;
    }

    .profile-links {
        flex-wrap: wrap;
        gap: 12px 28px;
        margin-top: 24px;
    }

    .profile-links a {
        gap: 8px;
        min-height: 44px;
        font-size: 13px;
        color: var(--about-muted);
    }

    .about-intro {
        padding-bottom: 56px;
    }

    .about-section {
        display: grid;
        grid-template-columns: 200px minmax(0, 1fr);
        gap: 48px;
        padding: 44px 0;
        border-top: 1px solid var(--color-border);
    }

    .section-number {
        display: block;
        margin-bottom: 12px;
        font-variant-numeric: tabular-nums;
    }

    h2 {
        font-size: 14px;
        line-height: 1.5;
        font-weight: 500;
        letter-spacing: -0.015em;
    }

    h3 {
        font-size: 16px;
        font-weight: 500;
        letter-spacing: -0.025em;
    }

    .focus-content {
        display: grid;
        gap: 28px;
    }

    .focus-item p {
        margin-top: 8px;
        color: var(--about-muted);
        font-size: 15px;
        line-height: 1.8;
        text-wrap: pretty;
    }

    .text-link {
        width: fit-content;
        gap: 6px;
        margin-top: 10px;
        min-height: 44px;
        font-size: 13px;
        color: var(--about-accent);
    }

    .company + .company {
        margin-top: 28px;
        padding-top: 28px;
        border-top: 1px solid var(--color-border);
    }

    .company-heading {
        gap: 8px;
        margin-bottom: 12px;
    }

    .company-heading a {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 28px;
        height: 28px;
        color: var(--about-muted);
    }

    .positions {
        display: grid;
        gap: 12px;
        list-style: none;
    }

    .position {
        justify-content: space-between;
        align-items: baseline;
        gap: 8px 20px;
        color: var(--about-muted);
        font-size: 14px;
        line-height: 1.6;
    }

    .position-current {
        color: var(--color-text);
    }

    .position-name {
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    .current-dot {
        width: 6px;
        height: 6px;
        flex-shrink: 0;
        border-radius: 50%;
        background: var(--about-accent);
    }

    .position-dates {
        flex-shrink: 0;
        font-size: 12px;
        font-variant-numeric: tabular-nums;
        color: var(--about-muted);
    }

    .work-details {
        margin-top: 12px;
        color: var(--about-muted);
        font-size: 13px;
        line-height: 1.8;
    }

    summary {
        width: fit-content;
        padding: 10px 0;
        cursor: pointer;
        text-underline-offset: 4px;
    }

    summary:hover {
        color: var(--about-accent);
    }

    .work-details-content {
        padding: 12px 0 0 16px;
        border-left: 1px solid var(--color-border);
    }

    .role-details + .role-details {
        margin-top: 20px;
    }

    .role-details h4,
    .detail-heading {
        font-weight: 500;
        color: var(--color-text);
    }

    .role-details p {
        margin-top: 8px;
    }

    .detail-bullet {
        position: relative;
        padding-left: 14px;
    }

    .detail-bullet::before {
        content: "·";
        position: absolute;
        left: 0;
    }

    .contact-content > p {
        margin-bottom: 12px;
        color: var(--about-muted);
        font-size: 15px;
    }

    .contact-link {
        width: fit-content;
        gap: 10px;
        font-size: clamp(17px, 2.5vw, 24px);
        min-height: 44px;
        letter-spacing: -0.035em;
        text-decoration: underline;
        text-decoration-color: var(--color-border);
        text-underline-offset: 7px;
    }

    a:hover {
        color: var(--about-accent);
    }

    a:focus-visible,
    summary:focus-visible {
        outline: 2px solid var(--about-accent);
        outline-offset: 5px;
        border-radius: 2px;
    }

    @media (max-width: 700px) {
        .about-page {
            padding-top: 44px;
            padding-bottom: 12px;
        }

        .intro-topline {
            flex-wrap: wrap;
            gap: 8px 20px;
        }

        .intro-identity {
            gap: 16px;
            margin-top: 28px;
        }

        .portrait {
            width: 82px;
            height: 82px;
            padding: 4px;
        }

        .portrait :global(.about-avatar),
        .portrait :global(img),
        .portrait :global([role="img"]) {
            width: 72px !important;
            height: 72px !important;
        }

        .role {
            max-width: 230px;
            font-size: 14px;
            line-height: 1.6;
        }

        .intro-text {
            margin-top: 24px;
        }

        .about-intro {
            padding-bottom: 32px;
        }

        .about-section {
            grid-template-columns: 1fr;
            gap: 24px;
            padding: 32px 0;
        }

        .section-label {
            display: flex;
            align-items: baseline;
            gap: 12px;
        }

        .section-number {
            margin-bottom: 0;
        }

        .position {
            flex-wrap: wrap;
            gap: 2px 16px;
        }
    }

    @media (max-width: 380px) {
        .intro-identity {
            align-items: flex-start;
        }

        h1 {
            font-size: 39px;
        }
    }
</style>
