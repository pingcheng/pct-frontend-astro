---
import type { MarkdownLayoutProps } from "astro";
import FixedWidthLayout from "./FixedWidthLayout.astro";
import { profile } from "@/data/profile";
import {
    formatPostDate,
    readingMinutes,
    type BlogFrontmatter,
} from "@/utils/blog";
import { MdArrowBack, MdArrowOutward } from "react-icons/md";

type Props = MarkdownLayoutProps<BlogFrontmatter>;
const { frontmatter: post, rawContent } = Astro.props;
const canonical = new URL(Astro.url.pathname.replace(/\/$/, ""), Astro.site)
    .href;
---

<FixedWidthLayout
    title={`${post.title} | Ping Cheng`}
    description={post.description}
    ogUrl={canonical}
    ogType="article"
>
    <main class="article-page">
        <a class="back-link" href="/blog">
            <MdArrowBack size={16} aria-hidden="true" />
            Back to blog
        </a>
        <article aria-labelledby="article-title">
            <header class="article-header animate-fade-in">
                <div class="article-topline">
                    <p class="studio-eyebrow">{post.topic}</p>
                </div>
                <h1 id="article-title">{post.title}</h1>
                <p class="standfirst">{post.description}</p>
                <div class="article-meta">
                    <span>{profile.fullName}</span>
                    <time datetime={post.publishedAt}>
                        {formatPostDate(post.publishedAt)}
                    </time>
                    <span>{readingMinutes(rawContent())} min read</span>
                </div>
            </header>
            <div class="article-body">
                <slot />
            </div>
        </article>
        <footer class="article-footer">
            <p>Thanks for reading.</p>
            <a class="studio-link" href="/blog">
                All blog posts <MdArrowOutward size={16} aria-hidden="true" />
            </a>
        </footer>
    </main>
</FixedWidthLayout>

<style>
    .article-page {
        max-width: 760px;
        margin-inline: auto;
        padding: var(--page-space) 0 48px;
    }
    .back-link {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        min-height: 44px;
        margin-bottom: 40px;
        font-size: 12px;
        color: var(--color-text-secondary);
    }
    .article-topline {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 16px;
    }
    h1 {
        margin-top: 24px;
        font-family: var(--font-display);
        font-size: clamp(40px, 6vw, 64px);
        font-weight: 400;
        line-height: 1.12;
        letter-spacing: -0.045em;
        overflow-wrap: anywhere;
    }
    .standfirst {
        margin-top: 28px;
        color: var(--color-text-secondary);
        font-size: clamp(18px, 2.5vw, 22px);
        line-height: 1.7;
    }
    .article-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 10px 24px;
        margin-top: 28px;
        padding-bottom: 32px;
        border-bottom: 1px solid var(--color-border);
        color: var(--color-text-secondary);
        font-family: var(--font-code);
        font-size: 11px;
    }
    .article-body {
        max-width: var(--reading-width);
        margin: 40px auto 0;
        overflow-wrap: anywhere;
        font-size: 17px;
        line-height: 1.9;
    }
    .article-body :global(p) {
        margin-block: 24px;
    }
    .article-body :global(h2),
    .article-body :global(h3),
    .article-body :global(h4) {
        font-family: var(--font-display);
        font-weight: 400;
        line-height: 1.3;
        letter-spacing: -0.025em;
    }
    .article-body :global(h2) {
        margin: 52px 0 20px;
        font-size: clamp(28px, 4vw, 36px);
    }
    .article-body :global(h3) {
        margin: 32px 0 16px;
        font-size: 25px;
    }
    .article-body :global(h4) {
        margin: 28px 0 14px;
        font-size: 21px;
    }
    .article-body :global(a) {
        color: var(--color-accent);
        text-decoration: underline;
        text-underline-offset: 4px;
    }
    .article-body :global(strong) {
        font-weight: 600;
    }
    .article-body :global(ul),
    .article-body :global(ol) {
        padding-left: 26px;
        margin-block: 24px;
    }
    .article-body :global(ul) {
        list-style: disc;
    }
    .article-body :global(ol) {
        list-style: decimal;
    }
    .article-body :global(li) {
        padding-left: 4px;
        margin-block: 8px;
    }
    .article-body :global(blockquote) {
        margin-block: 32px;
        padding: 2px 0 2px 24px;
        border-left: 2px solid var(--color-accent);
        font-family: var(--font-display);
        font-size: 23px;
        color: var(--color-text-secondary);
    }
    .article-body :global(code) {
        font-family: var(--font-code);
        font-size: 0.82em;
    }
    .article-body :global(:not(pre) > code) {
        padding: 3px 5px;
        background: var(--color-card);
        border: 1px solid var(--color-border);
        border-radius: 2px;
    }
    .article-body :global(pre) {
        max-width: 100%;
        overflow-x: auto;
        padding: 24px;
        margin-block: 28px;
        border: 1px solid var(--color-border);
        border-radius: 2px;
        line-height: 1.8;
        tab-size: 2;
    }
    .article-body :global(pre code) {
        white-space: pre;
        overflow-wrap: normal;
    }
    .article-body :global(hr) {
        margin-block: 40px;
        border-color: var(--color-border);
    }
    .article-body :global(table) {
        display: block;
        max-width: 100%;
        overflow-x: auto;
        border-collapse: collapse;
        margin-block: 28px;
        font-size: 14px;
    }
    .article-body :global(th),
    .article-body :global(td) {
        padding: 12px 16px;
        text-align: left;
        border-bottom: 1px solid var(--color-border);
    }
    .article-body :global(th) {
        font-weight: 600;
        background: var(--color-card);
    }
    .article-body :global(img) {
        height: auto;
        margin-block: 28px;
    }
    .article-footer {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
        margin-top: 56px;
        padding-top: 24px;
        border-top: 1px solid var(--color-border);
    }
    .article-footer p {
        color: var(--color-text-secondary);
        font-family: var(--font-display);
        font-size: 21px;
    }
    @media (max-width: 700px) {
        .back-link {
            margin-bottom: 24px;
        }
        .article-body {
            font-size: 16px;
        }
        .article-body :global(pre) {
            padding: 18px;
        }
        .article-body :global(blockquote) {
            padding-left: 18px;
            font-size: 21px;
        }
        .article-meta {
            gap: 8px 18px;
        }
    }
</style>
