---
import '@/styles/globals.css';
import { ClientRouter } from 'astro:transitions';
import type { TransitionDirectionalAnimations } from 'astro';
import type { SEOProps } from '@/models/SEOProps';

type Props = SEOProps;

const {
  title,
  description = import.meta.env.PUBLIC_APP_DESCRIPTION || '',
  keywords = 'ping,cheng,software,developer,high,passionate',
  canonicalUrl,
  ogTitle,
  ogDescription,
  ogUrl,
  ogType = 'website',
  ogImage = 'https://www.pingchengtech.com/apple-icon.png',
  twitterCard = 'summary',
  twitterTitle,
  twitterDescription,
  twitterImage = 'https://www.pingchengtech.com/apple-icon.png',
} = Astro.props;

const gaMeasurementId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID;
const absoluteOgImage = ogImage ? new URL(ogImage, Astro.site).href : undefined;
const absoluteTwitterImage = twitterImage ? new URL(twitterImage, Astro.site).href : undefined;
const gaConfigScript = gaMeasurementId
  ? `
window.dataLayer = window.dataLayer || [];
function gtag(){window.dataLayer.push(arguments);}
window.gtag = gtag;
gtag('js', new Date());
gtag('config', ${JSON.stringify(gaMeasurementId)});
// Client-side navigations don't reload the page, so report them explicitly.
let isFirstPageLoad = true;
document.addEventListener('astro:page-load', function () {
  if (isFirstPageLoad) { isFirstPageLoad = false; return; }
  gtag('event', 'page_view', { page_location: location.href, page_title: document.title });
});
`
  : '';

// A quick fade out, then the new page settles in with a short rise.
const pageSwap = {
  old: { name: 'page-out', duration: '140ms', easing: 'cubic-bezier(0.4, 0, 1, 1)', fillMode: 'both' },
  new: { name: 'page-in', duration: '280ms', delay: '60ms', easing: 'cubic-bezier(0.22, 1, 0.36, 1)', fillMode: 'both' },
};
const pageTransition: TransitionDirectionalAnimations = { forwards: pageSwap, backwards: pageSwap };
---

<html lang="en-AU" transition:animate={pageTransition}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-icon.png" />
    <link rel="preload" href="/fonts/InterVariable-latin.woff2" as="font" type="font/woff2" crossorigin />

    <title>{title}</title>
    {(canonicalUrl || ogUrl) && <link rel="canonical" href={canonicalUrl || ogUrl} />}
    {description && <meta name="description" content={description} />}
    {keywords && <meta name="keywords" content={keywords} />}

    {/* Open Graph */}
    {(ogTitle || title) && <meta property="og:title" content={ogTitle || title} />}
    {(ogDescription || description) && <meta property="og:description" content={ogDescription || description} />}
    {ogUrl && <meta property="og:url" content={ogUrl} />}
    <meta property="og:type" content={ogType} />
    {absoluteOgImage && <meta property="og:image" content={absoluteOgImage} />}

    {/* Twitter */}
    <meta name="twitter:card" content={twitterCard} />
    {(twitterTitle || title) && <meta name="twitter:title" content={twitterTitle || title} />}
    {(twitterDescription || description) && <meta name="twitter:description" content={twitterDescription || description} />}
    {absoluteTwitterImage && <meta name="twitter:image" content={absoluteTwitterImage} />}

    <slot name="head" />
    <ClientRouter />
    <script>
      // Entrance animations are for the first visit only; later pages use the page transition.
      document.addEventListener('astro:before-swap', (event) => {
        event.newDocument.documentElement.dataset.navigated = '';
      });
    </script>
  </head>
  <body>
    <slot />

    {/* Google Analytics */}
    {gaMeasurementId && (
      <>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaMeasurementId}`}></script>
        <script is:inline set:html={gaConfigScript} />
      </>
    )}

  </body>
</html>
