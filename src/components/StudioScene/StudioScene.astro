        --scene-wood: #a27b59;
        --scene-desktop: #ddcbae;
        --scene-gold: #c5a060;
        --scene-ink: #514a3d;
        --scene-screen: #e6e2cf;
        --scene-paper: #f5edda;
        --scene-shadow: #d9d0be;
        --scene-aluminium-top: #d7dcd7;
        --scene-aluminium: #a5ada7;
        --scene-bezel: #2a2c29;
        --scene-port: #48534e;
        --scene-status: #f6f6dc;
        --scene-gpt: #bbd586;
        --scene-grok: #252824;
        --scene-eyes: #292a24;
        --scene-face: #fbf2dd;
        display: block;
        width: 100%;
        height: auto;
    }
    svg.s2 * {
        animation-delay: calc(var(--s2-off, 0s) - var(--s2-t, 0s));
    }
    .s2-type {
        stroke-dasharray: 1;
        stroke-dashoffset: 0;
    }
    .s2-prompt {
        animation: s2-prompt 9s steps(1, end) infinite;
    }
    .s2-c1 {
        animation: s2-c1 9s steps(1, end) infinite;
    }
    .s2-c2 {
        animation: s2-c2 9s steps(1, end) infinite;
    }
    .s2-c3 {
        animation: s2-c3 9s steps(1, end) infinite;
    }
    .s2-content {
        animation: s2-fade 9s linear infinite;
    }
    .s2-tick {
        transform-box: fill-box;
        transform-origin: center;
        animation: s2-tick 9s linear infinite;
    }
    .s2-cursor {
        animation: s2-cursor 1s steps(1, end) infinite;
    }
    .s2-led {
        animation: s2-led 9s steps(1, end) infinite;
    }
    .s2-cloud {
        animation: s2-cloud 9s ease-in-out infinite;
    }
    .s2-steam {
        opacity: 0;
        animation: s2-steam 3s linear infinite;
    }
    .s2-steam-late {
        --s2-off: -1.5s;
    }
    .s2-hop-claude {
        animation: s2-hop-claude 9s linear infinite;
    }
    .s2-hop-dots {
        animation: s2-hop-dots 9s linear infinite;
    }
    .s2-hop-grok {
        animation: s2-hop-grok 9s linear infinite;
    }
    .s2-sh {
        transform-box: fill-box;
        transform-origin: center;
        opacity: 0.35;
    }
    .s2-sh-claude {
        animation: s2-hop-claude-sh 9s linear infinite;
    }
    .s2-sh-dots {
        animation: s2-hop-dots-sh 9s linear infinite;
    }
    .s2-sh-grok {
        animation: s2-hop-grok-sh 9s linear infinite;
    }
    .s2-eyes {
        transform-box: fill-box;
        transform-origin: center;
    }
    .s2-eyes-claude {
        animation: s2-blink-claude 9s linear infinite;
    }
    .s2-eyes-dots {
        animation: s2-blink-dots 9s linear infinite;
    }
    .s2-eyes-grok {
        animation: s2-blink-grok 9s linear infinite;
    }
    @keyframes s2-prompt {
        4% {
            stroke-dashoffset: 1px;
        }
        5.6% {
            stroke-dashoffset: 0.875px;
        }
        7.2% {
            stroke-dashoffset: 0.75px;
        }
        8.8% {
            stroke-dashoffset: 0.625px;
        }
        10.4% {
            stroke-dashoffset: 0.5px;
        }
        12% {
            stroke-dashoffset: 0.375px;
        }
        13.6% {
            stroke-dashoffset: 0.25px;
        }
        15.2% {
            stroke-dashoffset: 0.125px;
        }
        16.8% {
            stroke-dashoffset: 0px;
        }
        0% {
            stroke-dashoffset: 1px;
        }
        100% {
            stroke-dashoffset: 0;
        }
    }
    @keyframes s2-c1 {
