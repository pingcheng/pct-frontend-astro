<style>
    .studio-scene {
        --scene-frame: #af8f70;
        --scene-sky: #e5e9db;
        --scene-cloud: #fbf6e9;
        --scene-sun: #d5ac69;
        --scene-hill: #b0bc94;
        --scene-leaf: #7b8a63;
        --scene-moss: #59674b;
        --scene-clay: #b5684d;
        --scene-claude: #d27a58;
        --scene-wood: #a27b59;
        --scene-desktop: #ddcbae;
        --scene-gold: #c5a060;
        --scene-ink: #514a3d;
        --scene-screen: #e6e2cf;
        --scene-paper: #f5edda;
        --scene-shadow: #d9d0be;
        --scene-aluminium-top: #d7dcd7;
        --scene-aluminium: #a5ada7;
        --scene-port: #48534e;
        --scene-status: #f6f6dc;
        --scene-gpt: #bbd586;
        --scene-grok: #252824;
        --scene-eyes: #292a24;
        --scene-face: #fbf2dd;
        display: block;
        width: 100%;
        height: auto;
    }
    .scene-steam {
        opacity: 0;
    }
    /* Small, stepped movements keep the original pixel-art character. */
    @media (prefers-reduced-motion: no-preference) {
        .scene-cloud {
            animation: cloud-drift 12s steps(6, end) infinite alternate;
        }
        .scene-steam {
            animation: steam-rise 4s steps(6, end) infinite;
        }
        .scene-steam-late {
            animation-delay: -2s;
        }
        .scene-cursor {
            animation: cursor-blink 1.6s step-end infinite;
        }
        .scene-prompt {
            animation: prompt-type 8s steps(10, end) infinite;
        }
        .scene-code-first {
            animation: code-first 8s steps(12, end) infinite;
        }
        .scene-code-second {
            animation: code-second 8s steps(12, end) infinite;
        }
        .scene-code-third {
            animation: code-third 8s steps(10, end) infinite;
        }
        .scene-build-success {
            animation: build-success 8s step-end infinite;
        }
    }
    /* All stages share one clock, holding the completed code before restarting. */
    @keyframes prompt-type {
        0%,
        5%,
        100% {
            stroke-dashoffset: 1;
        }
        20%,
        95% {
            stroke-dashoffset: 0;
        }
    }
    @keyframes code-first {
        0%,
        25%,
        100% {
            stroke-dashoffset: 1;
        }
        40%,
        95% {
            stroke-dashoffset: 0;
        }
    }
    @keyframes code-second {
        0%,
        40%,
        100% {
            stroke-dashoffset: 1;
        }
        55%,
        95% {
            stroke-dashoffset: 0;
        }
    }
    @keyframes code-third {
        0%,
        55%,
        100% {
            stroke-dashoffset: 1;
        }
        70%,
        95% {
            stroke-dashoffset: 0;
        }
    }
    @keyframes build-success {
        0%,
        100% {
            opacity: 0;
        }
        75%,
        95% {
            opacity: 1;
        }
    }
    @keyframes cloud-drift {
        from {
            transform: translateX(0);
        }
        to {
            transform: translateX(6px);
        }
    }
    @keyframes steam-rise {
        0% {
            opacity: 0;
            transform: translate(0, 2px);
        }
        25% {
            opacity: 0.45;
        }
        75% {
            opacity: 0.25;
        }
        100% {
            opacity: 0;
            transform: translate(2px, -8px);
        }
    }
    @keyframes cursor-blink {
        0%,
        100% {
            opacity: 1;
        }
        50% {
            opacity: 0;
        }
    }
    @media (prefers-color-scheme: dark) {
        .studio-scene {
            --scene-frame: #a98b68;
            --scene-sky: #444c43;
            --scene-cloud: #79816b;
            --scene-sun: #d3aa6a;
            --scene-hill: #657553;
            --scene-leaf: #91a174;
            --scene-moss: #a8b78b;
            --scene-ink: #b7a78a;
            --scene-screen: #3b4338;
            --scene-desktop: #6f604b;
            --scene-shadow: #484337;
            --scene-grok: #191d19;
        }
    }
</style>
