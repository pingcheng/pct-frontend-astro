<style>
    .studio-scene {
        --scene-frame: #af8f70;
        --scene-sky: #e5e9db;
        --scene-cloud: #fbf6e9;
        --scene-sun: #d5ac69;
        --scene-hill: #b0bc94;
        --scene-leaf: #7b8a63;
        --scene-moss: #59674b;
        --scene-clay: #b5684d;
