---
import { profile } from "@/data/profile";
---

<footer class="page-container">
    <div class="footer-inner">
        <p>
            Hand and AI crafted with <span class="heart">❤</span> by {
                profile.fullName
            }
        </p>
        <a href="/friends">Friends <span aria-hidden="true">↗</span></a>
    </div>
</footer>
<style>
    .footer-inner {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px 32px;
        flex-wrap: wrap;
        padding: 26px 0 32px;
        border-top: 1px solid var(--color-border);
        color: var(--color-text-secondary);
        font-size: 12px;
    }
    .heart {
        color: var(--color-accent);
    }
    a {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        min-height: 44px;
    }
</style>
